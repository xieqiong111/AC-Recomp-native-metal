+
+bool shared_memory_already_fits(const std::vector<uint32_t>& code, uint32_t required_bytes, uint32_t* declared_bytes) {
+    enum : uint32_t { OpTypeInt = 21, OpTypeArray = 28, OpTypePointer = 32, OpConstant = 43, OpVariable = 59 };
+    enum : uint32_t { StorageWorkgroup = 4 };
+    if (code.size() < 5 || !required_bytes) return false;
+
+    std::map<uint32_t, uint32_t> int_width;
+    std::map<uint32_t, std::pair<uint32_t, uint32_t>> constant, array, pointer;
+    std::vector<uint32_t> workgroup_pointer_types;
+    for (size_t i = 5; i < code.size();) {
+        const uint32_t length = code[i] >> 16;
+        if (!length || i + length > code.size()) return false;
+        const uint32_t op = code[i] & 0xffff;
+        const uint32_t* w = &code[i];
+        if (op == OpTypeInt && length == 4) int_width[w[1]] = w[2];
+        else if (op == OpConstant && length == 4) constant[w[2]] = {w[1], w[3]};
+        else if (op == OpTypeArray && length == 4) array[w[1]] = {w[2], w[3]};
+        else if (op == OpTypePointer && length == 4) pointer[w[1]] = {w[2], w[3]};
+        else if (op == OpVariable && length >= 4 && w[3] == StorageWorkgroup) workgroup_pointer_types.push_back(w[1]);
+        i += length;
+    }
+
+    if (workgroup_pointer_types.empty()) {
+        *declared_bytes = 0;
+        return true;  // No Workgroup variable means this SPIR-V shader does not use shared memory.
+    }
+    if (workgroup_pointer_types.size() != 1) return false;
+
+    const auto p = pointer.find(workgroup_pointer_types.front());
+    if (p == pointer.end() || p->second.first != StorageWorkgroup) return false;
+    const auto a = array.find(p->second.second);
+    if (a == array.end() || int_width[a->second.first] != 32) return false;
+    const auto c = constant.find(a->second.second);
+    if (c == constant.end() || c->second.second > std::numeric_limits<uint32_t>::max() / sizeof(uint32_t)) return false;
+
+    *declared_bytes = c->second.second * sizeof(uint32_t);
+    return *declared_bytes >= required_bytes;
+}
+
+void inject_alpha_test(std::vector<uint32_t>& code, const std::string& entry_name, uint32_t alpha_func, float alpha_ref) {
+    enum : uint32_t {
+        OpTypeBool = 20, OpTypeInt = 21, OpTypeFloat = 22, OpTypeVector = 23, OpTypePointer = 32,
+        OpConstant = 43, OpEntryPoint = 15, OpExecutionMode = 16, OpExecutionModeId = 331,
+        OpDecorate = 71, OpVariable = 59, OpFunction = 54, OpFunctionEnd = 56, OpReturn = 253,
+        OpReturnValue = 254, OpAccessChain = 65, OpLoad = 61, OpSelectionMerge = 247,
+        OpBranchConditional = 250, OpLabel = 248, OpKill = 252,
+        DecorationLocation = 30, StorageOutput = 3, ExecutionModelFragment = 4, ExecutionModeEarlyFragmentTests = 9,
+        OpFOrdEqual = 180, OpFUnordNotEqual = 183, OpFOrdLessThan = 184, OpFOrdGreaterThan = 186,
+        OpFOrdLessThanEqual = 188, OpFOrdGreaterThanEqual = 190,
+    };
+    if (alpha_func == 8) return;
+    if (alpha_func < 1 || alpha_func > 8) fail("native Metal: invalid NVN alpha compare function");
+    if (code.size() < 5) fail("native Metal: invalid SPIR-V for alpha test");
+
+    struct Instruction { size_t at; uint32_t op, length; };
+    struct TypeInfo { uint32_t first, second; };
+    struct ConstantInfo { uint32_t type, value; };
+    std::vector<Instruction> instructions;
+    std::map<uint32_t, uint32_t> float_width, int_width, int_signedness, vector_type, vector_count;
+    std::map<uint32_t, TypeInfo> pointers;
+    std::map<uint32_t, ConstantInfo> constants;
+    std::map<uint32_t, uint32_t> locations;
+    std::vector<std::pair<uint32_t, uint32_t>> output_variables;
+    uint32_t bool_type = 0, entry_function = 0;
+    size_t first_function = code.size();
+
+    for (size_t i = 5; i < code.size();) {
+        const uint32_t length = code[i] >> 16;
+        if (!length || i + length > code.size()) fail("native Metal: malformed SPIR-V in alpha-test specialization");
+        const uint32_t op = code[i] & 0xffff;
+        const uint32_t* w = &code[i];
+        instructions.push_back({i, op, length});
+        if (op == OpTypeBool && length == 2) bool_type = w[1];
+        else if (op == OpTypeInt && length == 4) int_width[w[1]] = w[2], int_signedness[w[1]] = w[3];
+        else if (op == OpTypeFloat && length == 3) float_width[w[1]] = w[2];
+        else if (op == OpTypeVector && length == 4) vector_type[w[1]] = w[2], vector_count[w[1]] = w[3];
+        else if (op == OpTypePointer && length == 4) pointers[w[1]] = {w[2], w[3]};
+        else if (op == OpConstant && length == 4) constants[w[2]] = {w[1], w[3]};
+        else if (op == OpDecorate && length >= 4 && w[2] == DecorationLocation) locations[w[1]] = w[3];
+        else if (op == OpVariable && length >= 4 && w[3] == StorageOutput) output_variables.emplace_back(w[1], w[2]);
+        else if (op == OpEntryPoint && length >= 4 && w[1] == ExecutionModelFragment) {
+            std::string name;
+            size_t interface_at = length;
+            bool terminated = false;
+            for (size_t word = 3; word < length && !terminated; ++word) {
+                for (size_t byte = 0; byte < 4; ++byte) {
+                    const char value = char((w[word] >> (8 * byte)) & 0xff);
+                    if (!value) { interface_at = word + 1; terminated = true; break; }
+                    name.push_back(value);
+                }
+            }
+            if (!terminated) fail("native Metal: malformed fragment entry-point name in alpha-test specialization");
+            if (name == entry_name) {
+                if (entry_function) fail("native Metal: duplicate fragment entry point in alpha-test specialization");
+                entry_function = w[2];
+            }
+        } else if (op == OpFunction && first_function == code.size()) {
+            first_function = i;
+        }
+        i += length;
+    }
+    if (!entry_function || first_function == code.size())
+        fail("native Metal: fragment entry point is missing for alpha-test specialization");
+    size_t declaration_insertion = first_function;
+    for (const Instruction& inst : instructions)
+        if (inst.at < first_function && inst.op == OpVariable) { declaration_insertion = inst.at; break; }
+
+    size_t return_count = 0;
+    uint32_t current_function = 0;
+    for (const Instruction& inst : instructions) {
+        const uint32_t* w = &code[inst.at];
+        if (inst.op == OpFunction) current_function = w[2];
+        if (current_function == entry_function) {
+            if (inst.op == OpReturn) ++return_count;
+            else if (inst.op == OpReturnValue)
+                fail("native Metal: fragment entry point has a value return during alpha-test specialization");
+        }
+        if (inst.op == OpFunctionEnd) current_function = 0;
+    }
+    if (!return_count) fail("native Metal: fragment entry point has no return for alpha-test specialization");
+
+    uint32_t output_variable = 0, float_type = 0, pointer_float = 0;
+    uint32_t uint_type = 0, constant_three = 0, reference_constant = 0;
+    uint32_t next_id = code[3];
+    if (!next_id) fail("native Metal: invalid SPIR-V id bound for alpha-test specialization");
+    std::vector<uint32_t> new_types, new_constants;
+    auto allocate_id = [&]() {
+        if (next_id == std::numeric_limits<uint32_t>::max())
+            fail("native Metal: SPIR-V id space exhausted during alpha-test specialization");
+        return next_id++;
+    };
+    if (alpha_func != 1) {
+        for (const auto& output : output_variables) {
+            const auto location = locations.find(output.second);
+            if (location == locations.end() || location->second != 0) continue;
+            const auto pointer = pointers.find(output.first);
+            if (pointer == pointers.end() || pointer->second.first != StorageOutput)
+                fail("native Metal: fragment output location 0 has an unsupported pointer type for alpha test");
+            const auto vector = vector_type.find(pointer->second.second);
+            if (vector == vector_type.end() || vector_count[pointer->second.second] != 4 ||
+                float_width[vector->second] != 32)
+                fail("native Metal: fragment output location 0 is not a float4 for alpha test");
+            if (output_variable) fail("native Metal: multiple fragment outputs use location 0 during alpha test");
+            output_variable = output.second;
+            float_type = vector->second;
+        }
+        if (!output_variable) fail("native Metal: fragment output location 0 is missing for alpha test");
+
+        for (const auto& pointer : pointers)
+            if (pointer.second.first == StorageOutput && pointer.second.second == float_type) {
+                pointer_float = pointer.first;
+                break;
+            }
+        if (!pointer_float) {
+            pointer_float = allocate_id();
+            new_types.insert(new_types.end(), {(4u << 16) | OpTypePointer, pointer_float, StorageOutput, float_type});
+        }
+        for (const auto& width : int_width)
+            if (width.second == 32 && int_signedness[width.first] == 0) { uint_type = width.first; break; }
+        if (!uint_type) {
+            uint_type = allocate_id();
+            new_types.insert(new_types.end(), {(4u << 16) | OpTypeInt, uint_type, 32, 0});
+        }
+        for (const auto& constant : constants)
+            if (constant.second.type == uint_type && constant.second.value == 3) { constant_three = constant.first; break; }
+        if (!constant_three) {
+            constant_three = allocate_id();
+            new_constants.insert(new_constants.end(), {(4u << 16) | OpConstant, uint_type, constant_three, 3});
+        }
+        uint32_t reference_bits = 0;
+        std::memcpy(&reference_bits, &alpha_ref, sizeof reference_bits);
+        for (const auto& constant : constants)
+            if (constant.second.type == float_type && constant.second.value == reference_bits) {
+                reference_constant = constant.first;
+                break;
+            }
+        if (!reference_constant) {
+            reference_constant = allocate_id();
+            new_constants.insert(new_constants.end(), {(4u << 16) | OpConstant, float_type, reference_constant, reference_bits});
+        }
+        if (!bool_type) {
+            bool_type = allocate_id();
+            new_types.insert(new_types.end(), {(2u << 16) | OpTypeBool, bool_type});
+        }
+    }
+
+    uint32_t compare_op = 0;
+    switch (alpha_func) {
+        case 2: compare_op = OpFOrdLessThan; break;
+        case 3: compare_op = OpFOrdEqual; break;
+        case 4: compare_op = OpFOrdLessThanEqual; break;
+        case 5: compare_op = OpFOrdGreaterThan; break;
+        case 6: compare_op = OpFUnordNotEqual; break;  // NVN NOTEQUAL is true when either operand is NaN.
+        case 7: compare_op = OpFOrdGreaterThanEqual; break;
+        default: break;
+    }
+
+    std::vector<uint32_t> patched;
+    patched.reserve(code.size() + new_types.size() + new_constants.size() + return_count * 36);
+    patched.insert(patched.end(), code.begin(), code.begin() + 5);
+    current_function = 0;
+    for (const Instruction& inst : instructions) {
+        const uint32_t* w = &code[inst.at];
+        if (inst.at == declaration_insertion) {
+            patched.insert(patched.end(), new_types.begin(), new_types.end());
+            patched.insert(patched.end(), new_constants.begin(), new_constants.end());
+        }
+        const bool early_mode = (inst.op == OpExecutionMode || inst.op == OpExecutionModeId) &&
+                                inst.length >= 3 && w[1] == entry_function &&
+                                w[2] == ExecutionModeEarlyFragmentTests;
+        if (early_mode) continue;  // Alpha discard must happen before depth/stencil writes.
+        if (inst.op == OpFunction) current_function = w[2];
+        if (inst.op == OpReturn && current_function == entry_function) {
+            if (alpha_func == 1) {
+                patched.push_back((1u << 16) | OpKill);
+                continue;  // OpKill replaces the original terminating return.
+            } else {
+                const uint32_t pointer = allocate_id(), alpha = allocate_id(), passed = allocate_id();
+                const uint32_t merge = allocate_id(), discard = allocate_id();
+                patched.insert(patched.end(), {(5u << 16) | OpAccessChain, pointer_float, pointer, output_variable, constant_three,
+                                               (4u << 16) | OpLoad, float_type, alpha, pointer,
+                                               (5u << 16) | compare_op, bool_type, passed, alpha, reference_constant,
+                                               (3u << 16) | OpSelectionMerge, merge, 0,
+                                               (4u << 16) | OpBranchConditional, passed, merge, discard,
+                                               (2u << 16) | OpLabel, discard,
+                                               (1u << 16) | OpKill,
+                                               (2u << 16) | OpLabel, merge});
+            }
+        }
+        patched.insert(patched.end(), code.begin() + inst.at, code.begin() + inst.at + inst.length);
+        if (inst.op == OpFunctionEnd) current_function = 0;
+    }
+    if (patched.size() < 5) fail("native Metal: alpha-test specialization produced invalid SPIR-V");
+    code.swap(patched);
+    code[3] = next_id;
+}
+
+std::vector<uint32_t> patched_metal_spirv(const ShaderInfo* info, const uint8_t* integer_inputs, uint32_t unwritten,
+                                          uint32_t alpha_func, float alpha_ref) {
+    std::vector<uint32_t> code = info->spirv;
+    std::vector<uint32_t> next;
+
+    if (integer_inputs && patch_int_inputs(code, integer_inputs, next)) code.swap(next);
+    if (info->control.shared_size && info->stage != ShaderStage::Compute)
+        fail("native Metal: non-compute shader declares shared memory " + info->hash);
+    if (info->stage == ShaderStage::Compute && info->control.shared_size) {
+        if (resize_shared_memory(code, info->control.shared_size, next)) {
+            code.swap(next);
+        } else {
+            uint32_t declared_bytes = 0;
+            if (!shared_memory_already_fits(code, info->control.shared_size, &declared_bytes))
+                fail("native Metal: compute shader shared-memory resize failed (control=" +
+                     std::to_string(info->control.shared_size) + " bytes, SPIR-V=" +
+                     std::to_string(declared_bytes) + " bytes): " + info->hash);
+        }
+    }
+    if (unwritten && default_unwritten_inputs(code, unwritten, next)) code.swap(next);
+    if (clamp_uniform_indices(code, next, nullptr)) code.swap(next);
+
+    // Preserve the existing Apple defaults for the opt-in shader patches.
+    if (info->stage == ShaderStage::Vertex && enabled("NX_ZERO_VS_OUTPUTS") && zero_vertex_outputs(code, next))
+        code.swap(next);
+    if (info->stage == ShaderStage::Vertex && enabled("NX_INVARIANT") && make_position_invariant(code, next))
+        code.swap(next);
+    if (info->stage != ShaderStage::Compute && enabled("NX_FLOAT_CONTROLS") && preserve_inf_nan(code, next))
+        code.swap(next);
+    if (info->stage == ShaderStage::Vertex && pipeline_depth_mode() == 0) {
+        if (!patch_clip_z(code, next))
+            fail("native Metal: could not remap vertex clip-space depth for shader " + info->hash);
+        code.swap(next);
+    }
+    if (info->stage == ShaderStage::Fragment) inject_alpha_test(code, info->refl.entry, alpha_func, alpha_ref);
+    else if (alpha_func != 8) fail("native Metal: alpha test was supplied for a non-fragment shader");
+    return code;
+}
+
+void validate_source(const DescriptorBinding& binding) {
+    const NvnSource source = binding.nvn.source;
+    switch (binding.type) {
+        case DescriptorType::UniformBuffer:
+            if (binding.set > 1 || (source != NvnSource::SupportBuffer && source != NvnSource::DriverConstants &&
+                                    source != NvnSource::ConstantData && source != NvnSource::UniformBlock &&
+                                    source != NvnSource::UniformAsStorage))
+                fail("native Metal: unsupported uniform-buffer mapping " + binding.name);
+            return;
+        case DescriptorType::StorageBuffer:
+            if (binding.set > 1 || (source != NvnSource::StorageBuffer && source != NvnSource::UniformAsStorage))
+                fail("native Metal: unsupported storage-buffer mapping " + binding.name);
+            return;
+        case DescriptorType::CombinedImageSampler:
+        case DescriptorType::SampledImage:
+        case DescriptorType::Sampler:
+            if (binding.set != 2 || (source != NvnSource::SamplerBinding && source != NvnSource::HandleInUniform))
+                fail("native Metal: unsupported sampled-resource mapping " + binding.name);
+            return;
+        case DescriptorType::StorageImage:
+            if (binding.set != 3 || source != NvnSource::ImageBinding)
+                fail("native Metal: unsupported storage-image mapping " + binding.name);
+            return;
+        case DescriptorType::UniformTexelBuffer:
+        case DescriptorType::StorageTexelBuffer:
+        default:
+            fail("native Metal: unsupported descriptor type for " + binding.name);
+    }
+}
+
+template <typename ResourceList>
+void collect_active(const ResourceList& resources, spirv_cross::CompilerMSL& compiler, std::set<EntryKey>& active) {
+    for (const spirv_cross::Resource& resource : resources) {
+        if (!compiler.has_decoration(resource.id, spv::DecorationDescriptorSet) ||
+            !compiler.has_decoration(resource.id, spv::DecorationBinding))
+            fail("native Metal: active resource has no descriptor set/binding");
+        active.emplace(compiler.get_decoration(resource.id, spv::DecorationDescriptorSet),
+                       compiler.get_decoration(resource.id, spv::DecorationBinding));
+    }
+}
+
+void collect_active_resources(spirv_cross::CompilerMSL& compiler, std::set<EntryKey>& active) {
+    const auto variables = compiler.get_active_interface_variables();
+    const auto resources = compiler.get_shader_resources(variables);
+    collect_active(resources.uniform_buffers, compiler, active);
+    collect_active(resources.storage_buffers, compiler, active);
+    collect_active(resources.sampled_images, compiler, active);
+    collect_active(resources.separate_images, compiler, active);
+    collect_active(resources.separate_samplers, compiler, active);
+    collect_active(resources.storage_images, compiler, active);
+    collect_active(resources.atomic_counters, compiler, active);
+    collect_active(resources.subpass_inputs, compiler, active);
+    collect_active(resources.acceleration_structures, compiler, active);
+    collect_active(resources.gl_plain_uniforms, compiler, active);
+    collect_active(resources.tensors, compiler, active);
+    if (!resources.push_constant_buffers.empty() || !resources.shader_record_buffers.empty())
+        fail("native Metal: push-constant or shader-record resources are unsupported");
+}
+
+void add_resource_binding(spirv_cross::CompilerMSL& compiler, spv::ExecutionModel model,
+                          const DescriptorBinding& descriptor, uint32_t buffer, uint32_t texture,
+                          uint32_t sampler) {
+    spirv_cross::MSLResourceBinding mapped{};
+    mapped.stage = model;
+    mapped.desc_set = descriptor.set;
+    mapped.binding = descriptor.binding;
+    mapped.count = descriptor.count;
+    mapped.msl_buffer = buffer;
+    mapped.msl_texture = texture;
+    mapped.msl_sampler = sampler;
+    compiler.add_msl_resource_binding(mapped);
+}
+
+DescriptorBinding array_element(const DescriptorBinding& base, uint32_t element) {
+    DescriptorBinding binding = base;
+    binding.count = 1;
+    if (!element) return binding;
+    switch (binding.nvn.source) {
+        case NvnSource::UniformBlock:
+        case NvnSource::UniformAsStorage:
+        case NvnSource::StorageBuffer:
+        case NvnSource::SamplerBinding:
+        case NvnSource::ImageBinding:
+            binding.nvn.index += int(element);
+            break;
+        case NvnSource::HandleInUniform:
+            binding.nvn.word += int(element * 2);
+            break;
+        case NvnSource::SupportBuffer:
+        case NvnSource::DriverConstants:
+        case NvnSource::ConstantData:
+        default:
+            fail("native Metal: descriptor array has no NVN element mapping " + base.name);
+    }
+    return binding;
+}
+
+// Exact-size buffers preserve each descriptor's independent bounds and zero padding. Only completed GPU work
+// returns a buffer to the ready pool; the pool retains at most 64 MiB between command buffers.
+struct SnapshotBuffer {
+    __strong id<MTLBuffer> buffer = nil;
+    NSUInteger source_size = 0;
+};
+std::map<NSUInteger, std::vector<SnapshotBuffer>> g_snapshot_ready;
+std::vector<SnapshotBuffer> g_snapshot_live;
+SnapshotStats g_snapshot_stats;
+constexpr uint64_t kSnapshotRetainedLimit=64ull*1024*1024;
+
+// Host-derived bindings have immutable contents within one command buffer. Keep each distinct value's
+// snapshot until GPU completion; never deduplicate guest uniforms by address.
+struct SupportSnapshot {
+    std::array<uint32_t, 2> viewport;
+    __strong id<MTLBuffer> buffer = nil;
+};
+struct DriverSnapshot {
+    ShaderStage stage = ShaderStage::Unknown;
+    std::array<replay::Range, 16> storage{}, uniforms{};
+    __strong id<MTLBuffer> buffer = nil;
+};
+constexpr size_t kHostBindingCacheLimit = 32;
+std::vector<SupportSnapshot> g_support_snapshots;
+std::vector<DriverSnapshot> g_driver_snapshots;
+// shader_for() owns immutable ShaderInfo objects until process exit. These buffers are independent of the pool.
+std::map<const ShaderInfo*, id<MTLBuffer>> g_shader_constants;
+
+id<MTLBuffer> copied_buffer(const void* bytes, uint64_t source_size, uint64_t minimum_size,
+                            const std::string& label) {
+    if (source_size > std::numeric_limits<NSUInteger>::max() || minimum_size > std::numeric_limits<NSUInteger>::max())
+        fail("native Metal: buffer size is not representable for " + label);
+    uint64_t size = std::max<uint64_t>(std::max<uint64_t>(source_size, minimum_size), 16);
+    size = (size + 15) & ~uint64_t(15);
+    if (size > std::numeric_limits<NSUInteger>::max()) fail("native Metal: padded buffer is too large for " + label);
+    id<MTLDevice> metal_device = device();
+    if (!metal_device) fail("native Metal: no Metal device for " + label);
+    id<MTLBuffer> result = nil;
+    NSUInteger previous_source_size = 0;
+    bool reused = false;
+    auto found=g_snapshot_ready.find(static_cast<NSUInteger>(size));
+    if(found!=g_snapshot_ready.end() && !found->second.empty()) {
+        SnapshotBuffer snapshot = std::move(found->second.back());
+        found->second.pop_back();
+        result = snapshot.buffer;
+        previous_source_size = snapshot.source_size;
+        reused = true;
+        g_snapshot_stats.retained_bytes-=size;++g_snapshot_stats.reuses;
+    } else {
+        result=[metal_device newBufferWithLength:static_cast<NSUInteger>(size) options:MTLResourceStorageModeShared];
+        ++g_snapshot_stats.allocations;
+    }
+    if (!result || !result.contents) fail("native Metal: could not allocate buffer for " + label);
+    if (source_size && !bytes) fail("native Metal: source bytes are missing for " + label);
+    auto* destination = static_cast<uint8_t*>(result.contents);
+    if (source_size)
+        std::memcpy(destination, bytes, static_cast<size_t>(source_size));
+    // Every ready buffer has a zeroed suffix after its prior source prefix. Growth can
+    // therefore keep that suffix; shrinking only needs to clear bytes exposed from the
+    // previous prefix. A new allocation has no initialized suffix at all.
+    const uint64_t padding_size = size - source_size;
+    const uint64_t clear_size = reused
+        ? (source_size < previous_source_size ? previous_source_size - source_size : 0)
+        : padding_size;
+    if (clear_size)
+        std::memset(destination + source_size, 0, static_cast<size_t>(clear_size));
+    g_snapshot_live.push_back({result, static_cast<NSUInteger>(source_size)});
+    g_snapshot_stats.copied_bytes += source_size;
+    g_snapshot_stats.cleared_bytes += clear_size;
+    g_snapshot_stats.saved_clear_bytes += padding_size - clear_size;
+    return result;
+}
+
+id<MTLBuffer> support_snapshot(float width, float height) {
+    std::array<uint32_t, 2> viewport;
+    std::memcpy(&viewport[0], &width, sizeof width);
+    std::memcpy(&viewport[1], &height, sizeof height);
+    for (const auto& entry : g_support_snapshots) if (entry.viewport == viewport) {
+        ++g_snapshot_stats.support_reuses;
+        g_snapshot_stats.saved_copy_bytes += sizeof(SupportBuffer);
+        return entry.buffer;
+    }
+    SupportBuffer support = support_buffer_defaults();
+    support_buffer_set_viewport(support, width, height);
+    id<MTLBuffer> buffer = copied_buffer(&support, sizeof support, sizeof support, "support buffer");
+    if (g_support_snapshots.size() < kHostBindingCacheLimit)
+        g_support_snapshots.push_back({viewport, buffer});
+    return buffer;
+}
+
+bool same_ranges(const std::array<replay::Range, 16>& cached, const replay::Range* current) {
+    for (size_t n = 0; n < cached.size(); ++n)
+        if (cached[n].address != current[n].address || cached[n].size != current[n].size) return false;
+    return true;
+}
+
+id<MTLBuffer> driver_snapshot(ShaderStage stage, uint32_t nvn_stage) {
+    const auto& state = replay::g_state;
+    for (const auto& entry : g_driver_snapshots)
+        if (entry.stage == stage && same_ranges(entry.storage, state.storage[nvn_stage]) &&
+            (stage != ShaderStage::Compute || same_ranges(entry.uniforms, state.uniforms[nvn_stage]))) {
+            ++g_snapshot_stats.driver_reuses;
+            g_snapshot_stats.saved_copy_bytes += 0x1000;
+            return entry.buffer;
+        }
+    auto constants = replay::driver_constants(stage, int(nvn_stage));
+    id<MTLBuffer> buffer = copied_buffer(constants.data(), constants.size(), constants.size(), "driver constants");
+    if (g_driver_snapshots.size() < kHostBindingCacheLimit) {
+        DriverSnapshot entry;
+        entry.stage = stage;
+        std::copy_n(state.storage[nvn_stage], entry.storage.size(), entry.storage.begin());
+        if (stage == ShaderStage::Compute)
+            std::copy_n(state.uniforms[nvn_stage], entry.uniforms.size(), entry.uniforms.begin());
+        entry.buffer = buffer;
+        g_driver_snapshots.push_back(std::move(entry));
+    }
+    return buffer;
+}
+
+id<MTLBuffer> shader_constant_buffer(const ShaderInfo* info) {
+    if (info->control.const_size > info->constants.size())
+        fail("native Metal: constant data is shorter than its shader control section " + info->hash);
+    if (auto entry = g_shader_constants.find(info); entry != g_shader_constants.end()) {
+        ++g_snapshot_stats.constant_reuses;
+        g_snapshot_stats.saved_copy_bytes += info->control.const_size;
+        return entry->second;
+    }
+    const uint64_t source_size = info->control.const_size;
+    const NSUInteger size = static_cast<NSUInteger>((std::max<uint64_t>(source_size, 16) + 15) & ~uint64_t(15));
+    id<MTLBuffer> buffer = [device() newBufferWithLength:size options:MTLResourceStorageModeShared];
+    if (!buffer || !buffer.contents) fail("native Metal: shader constant allocation failed " + info->hash);
+    auto* destination = static_cast<uint8_t*>(buffer.contents);
+    if (source_size) std::memcpy(destination, info->constants.data(), static_cast<size_t>(source_size));
+    if (size > source_size) std::memset(destination + source_size, 0, static_cast<size_t>(size - source_size));
+    g_shader_constants.emplace(info, buffer);
+    g_snapshot_stats.constant_bytes += size;
+    return buffer;
+}
+
+id<MTLBuffer> snapshot_guest_buffer(uint64_t address, uint64_t guest_size, uint64_t minimum_size,
+                                   const std::string& label) {
+    if (!address || !guest_size) fail("native Metal: unbound guest buffer for " + label);
+    uint64_t source_size = std::min<uint64_t>(guest_size, 0x10000);
+    // This source is consumed only by memcpy. Resolve its exact byte range directly instead of
+    // creating/looking up a page-aligned Metal alias that will never be bound to the GPU.
+    const auto* bytes = mapped_buffer_bytes(address, source_size);
+    return copied_buffer(bytes, source_size, minimum_size, label);
+}
+
+Buffer guest_storage_buffer(uint64_t address, uint64_t size, const std::string& label) {
+    if (!address || !size) fail("native Metal: unbound guest storage buffer for " + label);
+    Buffer result = buffer_for_gpu(address, size, true);
+    if (!result.object || result.offset > result.object.length || size > result.object.length - result.offset)
+        fail("native Metal: writable guest storage mapping is invalid for " + label);
+    return result;
+}
+
+uint64_t texture_handle(const DescriptorBinding& descriptor, uint32_t nvn_stage, const replay::State& state) {
+    switch (descriptor.nvn.source) {
+        case NvnSource::SamplerBinding:
+            if (descriptor.nvn.index < 0 || descriptor.nvn.index >= 32)
+                fail("native Metal: sampler binding index is out of range for " + descriptor.name);
+            return state.textures[nvn_stage][descriptor.nvn.index];
+        case NvnSource::ImageBinding:
+            if (descriptor.nvn.index < 0 || descriptor.nvn.index >= 16)
+                fail("native Metal: image binding index is out of range for " + descriptor.name);
+            return state.images[nvn_stage][descriptor.nvn.index] & 0xFFFFFu;
+        case NvnSource::HandleInUniform: {
+            if (descriptor.nvn.bank < 3 || descriptor.nvn.bank - 3 >= 18 || descriptor.nvn.word < 0)
+                fail("native Metal: uniform texture-handle location is invalid for " + descriptor.name);
+            const replay::Range& range = state.uniforms[nvn_stage][descriptor.nvn.bank - 3];
+            uint64_t offset = uint64_t(descriptor.nvn.word) * 4;
+            if (!range.address || offset > range.size || sizeof(uint32_t) > range.size - offset ||
+                offset > UINT64_MAX - range.address)
+                fail("native Metal: uniform texture handle is outside its bound range for " + descriptor.name);
+            const uint8_t* bytes = mapped_buffer_bytes(range.address + offset, sizeof(uint32_t));
+            prepare_counter_read(bytes, sizeof(uint32_t));
+            uint32_t handle = 0;
+            std::memcpy(&handle, bytes, sizeof handle);
+            return handle;
+        }
+        default:
+            fail("native Metal: descriptor is not backed by a texture handle: " + descriptor.name);
+    }
+}
+
+}  // namespace
+
+void recycle_snapshot_buffers() {
+    g_support_snapshots.clear();
+    g_driver_snapshots.clear();
+    for(const SnapshotBuffer& snapshot:g_snapshot_live) {
+        const uint64_t size=snapshot.buffer.length;
+        if(size<=kSnapshotRetainedLimit-g_snapshot_stats.retained_bytes) {
+            g_snapshot_ready[snapshot.buffer.length].push_back(snapshot);
+            g_snapshot_stats.retained_bytes+=size;
+        }
+    }
+    g_snapshot_live.clear();
+}
+SnapshotStats snapshot_stats() { return g_snapshot_stats; }
+
+const Stage& stage(const ShaderInfo* info, const uint8_t* integer_inputs, uint32_t unwritten,
+                   uint32_t alpha_func, float alpha_ref) {
+    if (!info || !info->control.valid || info->spirv.size() < 5 || info->refl.stage != info->stage)
+        fail("native Metal: invalid shader info");
+
+    StageKey key;
+    key.info = info;
+    key.unwritten = unwritten;
+    key.alpha_func = alpha_func;
+    if (alpha_func != 1 && alpha_func != 8) std::memcpy(&key.alpha_ref_bits, &alpha_ref, sizeof alpha_ref);
+    if (integer_inputs) std::copy_n(integer_inputs, key.integer_inputs.size(), key.integer_inputs.begin());
+    std::lock_guard<std::mutex> guard(g_stage_mutex);
+    if (auto found = g_stages.find(key); found != g_stages.end()) return found->second;
+
+    const spv::ExecutionModel model = execution_model(info->stage);
+    std::vector<uint32_t> code = patched_metal_spirv(info, integer_inputs, unwritten, alpha_func, alpha_ref);
+    if (code.size() < 5) fail("native Metal: patched SPIR-V is empty for shader " + info->hash);
+
+    try {
+        spirv_cross::CompilerMSL compiler(std::move(code));
+        const auto entry_points = compiler.get_entry_points_and_stages();
+        bool found_entry = false;
+        for (const auto& entry : entry_points) {
+            if (entry.name == info->refl.entry && entry.execution_model == model) found_entry = true;
+        }
+        if (!found_entry) fail("native Metal: shader entry point does not match its recorded stage " + info->hash);
+        compiler.set_entry_point(info->refl.entry, model);
+
+        auto common_options = compiler.get_common_options();
+        common_options.vertex.flip_vert_y = false;  // NVN upper-left origin already matches Metal (old Vulkan used a negative viewport).
+        compiler.set_common_options(common_options);
+        auto msl_options = compiler.get_msl_options();
+        msl_options.platform = spirv_cross::CompilerMSL::Options::macOS;
+        msl_options.set_msl_version(3, 0);
+        msl_options.argument_buffers = false;
+        compiler.set_msl_options(msl_options);
+
+        std::set<EntryKey> active;
+        collect_active_resources(compiler, active);
+        std::set<EntryKey> known;
+        for (const DescriptorBinding& descriptor : info->refl.bindings) known.emplace(descriptor.set, descriptor.binding);
+        for (const EntryKey& binding : active)
+            if (!known.count(binding)) fail("native Metal: active SPIR-V descriptor is missing NVN reflection");
+
+        Stage compiled;
+        uint32_t next_buffer = 0, next_texture = 0, next_sampler = 0;
+        for (const DescriptorBinding& descriptor : info->refl.bindings) {
+            if (!active.count({descriptor.set, descriptor.binding})) continue;
+            validate_source(descriptor);
+            if (!descriptor.count) fail("native Metal: runtime-sized descriptor arrays are unsupported: " + descriptor.name);
+
+            uint32_t buffer_base = 0, texture_base = 0, sampler_base = 0;
+            switch (descriptor.type) {
+                case DescriptorType::UniformBuffer:
+                case DescriptorType::StorageBuffer:
+                    if (descriptor.count > 31 - next_buffer)
+                        fail("native Metal: active shader needs more than 31 buffer bindings: " + info->hash);
+                    buffer_base = next_buffer;
+                    next_buffer += descriptor.count;
+                    break;
+                case DescriptorType::CombinedImageSampler:
+                    if (descriptor.count > 128 - next_texture)
+                        fail("native Metal: active shader needs more than 128 texture bindings: " + info->hash);
+                    if (descriptor.count > 16 - next_sampler)
+                        fail("native Metal: active shader needs more than 16 sampler bindings: " + info->hash);
+                    texture_base = next_texture;
+                    sampler_base = next_sampler;
+                    next_texture += descriptor.count;
+                    next_sampler += descriptor.count;
+                    break;
+                case DescriptorType::SampledImage:
+                    if (descriptor.count > 128 - next_texture)
+                        fail("native Metal: active shader needs more than 128 texture bindings: " + info->hash);
+                    texture_base = next_texture;
+                    next_texture += descriptor.count;
+                    break;
+                case DescriptorType::Sampler:
+                    if (descriptor.count > 16 - next_sampler)
+                        fail("native Metal: active shader needs more than 16 sampler bindings: " + info->hash);
+                    sampler_base = next_sampler;
+                    next_sampler += descriptor.count;
+                    break;
+                case DescriptorType::StorageImage:
+                    if (descriptor.count > 128 - next_texture)
+                        fail("native Metal: active shader needs more than 128 texture bindings: " + info->hash);
+                    texture_base = next_texture;
+                    next_texture += descriptor.count;
+                    break;
+                default:
+                    fail("native Metal: unsupported descriptor type for " + descriptor.name);
+            }
+            add_resource_binding(compiler, model, descriptor, buffer_base, texture_base, sampler_base);
+
+            for (uint32_t element = 0; element < descriptor.count; ++element) {
+                Binding binding;
+                binding.descriptor = array_element(descriptor, element);
+                binding.buffer = buffer_base + element;
+                binding.texture = texture_base + element;
+                binding.sampler = sampler_base + element;
+                compiled.bindings.push_back(std::move(binding));
+            }
+        }
+        compiled.buffer_count = next_buffer;
+
+        const std::string source_text = compiler.compile();
+        const std::string function_name =
+            compiler.get_cleansed_entry_point_name(info->refl.entry, model);
+        NSString* source = [[NSString alloc] initWithBytes:source_text.data()
+                                                   length:source_text.size()
+                                                 encoding:NSUTF8StringEncoding];
+        if (!source) fail("native Metal: SPIRV-Cross emitted invalid MSL for shader " + info->hash);
+        NSError* error = nil;
+        id<MTLLibrary> library = [device() newLibraryWithSource:source options:nil error:&error];
+        if (!library) {
+            std::string detail = error.localizedDescription.UTF8String ? error.localizedDescription.UTF8String : "unknown Metal compiler error";
+            fail("native Metal: MSL compilation failed for shader " + info->hash + ": " + detail);
+        }
+        NSString* name = [[NSString alloc] initWithBytes:function_name.data()
+                                                  length:function_name.size()
+                                                encoding:NSUTF8StringEncoding];
+        if (!name) fail("native Metal: invalid MSL entry-point name for shader " + info->hash);
+        compiled.function = [library newFunctionWithName:name];
+        if (!compiled.function) fail("native Metal: Metal library is missing entry point " + function_name);
+        MTLFunctionType expected = info->stage == ShaderStage::Vertex ? MTLFunctionTypeVertex
+                                   : info->stage == ShaderStage::Fragment ? MTLFunctionTypeFragment
+                                                                         : MTLFunctionTypeKernel;
+        if (compiled.function.functionType != expected)
+            fail("native Metal: compiled function type does not match shader stage " + info->hash);
+
+        {
+            const char* stage_name = info->stage==ShaderStage::Vertex?"vertex":
+                                     info->stage==ShaderStage::Fragment?"fragment":"compute";
+            log("nvn/metal: stage fn=%p hash=%s kind=%s",(void*)(__bridge void*)compiled.function,info->hash.c_str(),stage_name);
+            static std::string dump_dir=[] {
+                const char* root=std::getenv("NX_SHADER_DUMP");
+                return root?std::string(root):std::string();
+            }();
+            if(!dump_dir.empty()) {
+                const std::string path=dump_dir+"/"+info->hash+"."+stage_name+".metal";
+                FILE* file=std::fopen(path.c_str(),"wb");
+                if(file){std::fwrite(source_text.data(),1,source_text.size(),file);std::fclose(file);}
+            }
+        }
+        auto inserted = g_stages.emplace(std::move(key), std::move(compiled));
+        return inserted.first->second;
+    } catch (const spirv_cross::CompilerError& error) {
+        fail("native Metal: SPIRV-Cross failed for shader " + info->hash + ": " + error.what());
+    } catch (const std::exception& error) {
+        fail("native Metal: shader compilation failed for " + info->hash + ": " + error.what());
+    }
+}
+
+StageImages prepare_stage_images(const Stage& compiled, const ShaderInfo* info, uint32_t nvn_stage,
+                                 const replay::State& state) {
+    if (!info || !compiled.function || nvn_stage != nvn_stage_index(info->stage))
+        fail("native Metal: invalid image preparation request");
+    // Actual uniform snapshots stay at bind time. Any wait they require must happen
+    // here, before the draw/dispatch encoder exists, so binding cannot end that encoder.
+    for (const auto& binding : compiled.bindings) {
+        const auto& descriptor = binding.descriptor;
+        const bool uniform = descriptor.type == DescriptorType::UniformBuffer &&
+            (descriptor.nvn.source == NvnSource::UniformBlock || descriptor.nvn.source == NvnSource::UniformAsStorage);
+        const bool uniform_storage = descriptor.type == DescriptorType::StorageBuffer &&
+            descriptor.nvn.source == NvnSource::UniformAsStorage;
+        if (!uniform && !uniform_storage) continue;
+        if (descriptor.nvn.index < 0 || descriptor.nvn.index >= 18)
+            fail("native Metal: uniform preflight index is out of range for " + descriptor.name);
+        const auto& range = state.uniforms[nvn_stage][descriptor.nvn.index];
+        if (!range.address || !range.size) fail("native Metal: unbound uniform preflight for " + descriptor.name);
+        const uint64_t length = std::min<uint64_t>(range.size, 0x10000);
+        // Snapshot copies read guest memory that pending GPU storage writes may still target; only an
+        // overlapping range forces a drain, keeping the render encoder open otherwise.
+        const uint8_t* bytes = mapped_buffer_bytes(range.address, length);
+        prepare_write_read(bytes, length);
+        prepare_counter_read(bytes, length);
+    }
+    StageImages result;
+    result.bindings.resize(compiled.bindings.size());
+    for (size_t index = 0; index < compiled.bindings.size(); ++index) {
+        const auto& descriptor = compiled.bindings[index].descriptor;
+        switch (descriptor.type) {
+            case DescriptorType::CombinedImageSampler:
+            case DescriptorType::SampledImage:
+            case DescriptorType::Sampler:
+            case DescriptorType::StorageImage: {
+                uint64_t handle = texture_handle(descriptor, nvn_stage, state);
+                uint64_t guest_texture = 0;
+                SamplerInfo sampler_info;
+                ViewInfo view;
+                const bool needs_texture = descriptor.type == DescriptorType::CombinedImageSampler ||
+                                           descriptor.type == DescriptorType::SampledImage ||
+                                           descriptor.type == DescriptorType::StorageImage;
+                const bool needs_sampler = descriptor.type == DescriptorType::CombinedImageSampler ||
+                                           descriptor.type == DescriptorType::Sampler;
+                if (needs_texture) replay::texture_for(handle, guest_texture, sampler_info, &view);
+                if (needs_sampler && !replay::sampler_for(handle, sampler_info))
+                    fail("native Metal: NVN sampler handle is unresolved for " + descriptor.name);
+
+                auto& image = result.bindings[index];
+                image.guest = guest_texture;
+                image.view = view;
+                if (needs_texture) {
+                    if (!guest_texture) fail("native Metal: NVN texture handle is unresolved for " + descriptor.name);
+                    image.texture = texture(guest_texture, &view, &descriptor.image, false,
+                                            descriptor.type == DescriptorType::StorageImage);
+                }
+                if (needs_sampler) image.sampler = sampler(sampler_info, descriptor.image.depth);
+                break;
+            }
+            default: break;  // Buffer descriptors are snapshotted during binding, as before.
+        }
+    }
+    return result;
+}
+
+void bind_stage(id<MTLRenderCommandEncoder> render, id<MTLComputeCommandEncoder> compute, const Stage& compiled,
+                const ShaderInfo* info, uint32_t nvn_stage, const replay::State& state, const StageImages& images,
+                float width, float height) {
+    if (!info || !compiled.function || nvn_stage != nvn_stage_index(info->stage))
+        fail("native Metal: invalid stage binding request");
+    if (images.bindings.size() != compiled.bindings.size()) fail("native Metal: prepared image bindings do not match stage");
+    if (info->stage == ShaderStage::Compute ? (!compute || render) : (!render || compute))
+        fail("native Metal: encoder does not match shader stage " + info->hash);
+
+    auto set_buffer = [&](id<MTLBuffer> buffer, NSUInteger offset, uint32_t index) {
+        if (!buffer || offset > buffer.length) fail("native Metal: invalid buffer at MSL index " + std::to_string(index));
+        switch (info->stage) {
+            case ShaderStage::Vertex: [render setVertexBuffer:buffer offset:offset atIndex:index]; break;
+            case ShaderStage::Fragment: [render setFragmentBuffer:buffer offset:offset atIndex:index]; break;
+            case ShaderStage::Compute: [compute setBuffer:buffer offset:offset atIndex:index]; break;
+            default: fail("native Metal: unsupported stage while binding buffers");
+        }
+    };
+    auto set_texture = [&](id<MTLTexture> texture, uint32_t index) {
+        if (!texture) fail("native Metal: required texture is unresolved at MSL index " + std::to_string(index));
+        switch (info->stage) {
+            case ShaderStage::Vertex: [render setVertexTexture:texture atIndex:index]; break;
+            case ShaderStage::Fragment: [render setFragmentTexture:texture atIndex:index]; break;
+            case ShaderStage::Compute: [compute setTexture:texture atIndex:index]; break;
+            default: fail("native Metal: unsupported stage while binding textures");
+        }
+    };
+    auto set_sampler = [&](id<MTLSamplerState> sampler, uint32_t index) {
+        if (!sampler) fail("native Metal: required sampler is unresolved at MSL index " + std::to_string(index));
+        switch (info->stage) {
+            case ShaderStage::Vertex: [render setVertexSamplerState:sampler atIndex:index]; break;
+            case ShaderStage::Fragment: [render setFragmentSamplerState:sampler atIndex:index]; break;
+            case ShaderStage::Compute: [compute setSamplerState:sampler atIndex:index]; break;
+            default: fail("native Metal: unsupported stage while binding samplers");
+        }
+    };
+
+    const uint64_t dynamic_uniforms = dynamic_uniform_bindings(info);
+    for (size_t index = 0; index < compiled.bindings.size(); ++index) {
+        const Binding& binding = compiled.bindings[index];
+        const DescriptorBinding& descriptor = binding.descriptor;
+        switch (descriptor.type) {
+            case DescriptorType::UniformBuffer: {
+                id<MTLBuffer> buffer = nil;
+                switch (descriptor.nvn.source) {
+                    case NvnSource::SupportBuffer:
+                        buffer = support_snapshot(width, height);
+                        break;
+                    case NvnSource::DriverConstants:
+                        buffer = driver_snapshot(info->stage, nvn_stage);
+                        break;
+                    case NvnSource::ConstantData:
+                        buffer = shader_constant_buffer(info);
+                        break;
+                    case NvnSource::UniformBlock:
+                    case NvnSource::UniformAsStorage: {
+                        if (descriptor.nvn.index < 0 || descriptor.nvn.index >= 18)
+                            fail("native Metal: uniform binding index is out of range for " + descriptor.name);
+                        const replay::Range& range = state.uniforms[nvn_stage][descriptor.nvn.index];
+                        const bool dynamic = descriptor.binding < 64 &&
+                                             ((dynamic_uniforms >> descriptor.binding) & 1u) != 0;
+                        buffer = snapshot_guest_buffer(range.address, range.size, dynamic ? 0x10000 : 0x1000,
+                                                       descriptor.name);
+                        break;
+                    }
+                    default:
+                        fail("native Metal: unsupported uniform source for " + descriptor.name);
+                }
+                set_buffer(buffer, 0, binding.buffer);
+                break;
+            }
+            case DescriptorType::StorageBuffer: {
+                if (descriptor.nvn.source == NvnSource::UniformAsStorage) {
+                    if (descriptor.nvn.index < 0 || descriptor.nvn.index >= 18)
+                        fail("native Metal: uniform-as-storage index is out of range for " + descriptor.name);
+                    const replay::Range& range = state.uniforms[nvn_stage][descriptor.nvn.index];
+                    const bool dynamic = descriptor.binding < 64 &&
+                                         ((dynamic_uniforms >> descriptor.binding) & 1u) != 0;
+                    id<MTLBuffer> buffer = snapshot_guest_buffer(range.address, range.size,
+                                                                 dynamic ? 0x10000 : 0x1000, descriptor.name);
+                    set_buffer(buffer, 0, binding.buffer);
+                } else {
+                    if (descriptor.nvn.index < 0 || descriptor.nvn.index >= 16)
+                        fail("native Metal: storage binding index is out of range for " + descriptor.name);
+                    const replay::Range& range = state.storage[nvn_stage][descriptor.nvn.index];
+                    Buffer buffer = guest_storage_buffer(range.address, range.size, descriptor.name);
+                    set_buffer(buffer.object, buffer.offset, binding.buffer);
+                }
+                break;
+            }
+            case DescriptorType::CombinedImageSampler:
+            case DescriptorType::SampledImage:
+            case DescriptorType::Sampler:
+            case DescriptorType::StorageImage: {
+                const auto& image = images.bindings[index];
+                if (descriptor.type != DescriptorType::Sampler) {
+                    set_texture(image.texture, binding.texture);
+                    if (descriptor.type == DescriptorType::StorageImage)
+                        mark_rendered(image.guest, &image.view, TextureAllAspects);
+                }
+                if (descriptor.type == DescriptorType::CombinedImageSampler || descriptor.type == DescriptorType::Sampler)
+                    set_sampler(image.sampler, binding.sampler);
+                break;
+            }
+            default:
+                fail("native Metal: unsupported descriptor while binding " + descriptor.name);
+        }
+    }
+}
+
+}  // namespace nx::nvn::metal
diff --git a/runtime/src/nvn/metal_shared.h b/runtime/src/nvn/metal_shared.h
