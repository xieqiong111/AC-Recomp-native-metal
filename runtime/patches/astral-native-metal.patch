+    submission.command=cmd;
+    submission.completed=done;
+    submission.serial=serial;
+    submission.reason=reason;
+    submission.encode_ns=commit_started-g_command_started_ns;
+    submission.deadline_ns=submitted_ns>std::numeric_limits<uint64_t>::max()-kGpuCommandTimeoutNs
+        ? std::numeric_limits<uint64_t>::max() : submitted_ns+kGpuCommandTimeoutNs;
+    submission.counters = std::move(g_counters_awaiting_submit);
+    g_pending_submissions.push_back(std::move(submission));
+    auto& timing=g_commit_timing[size_t(reason)];
+    ++timing.count;
+    timing.encode_ns+=g_pending_submissions.back().encode_ns;
+    // The current counter, if any, is now part of a committed record before a cap drain validates it.
+    if(g_pending_submissions.size()>=kMaxPendingSubmissions)drain_submissions();
+    return true;
+}
+void drain_submissions(bool wait_presents) {
+    // Fast counters recorded while the encoder stayed open may have no submission yet; publish their
+    // provisional values before the in-flight checks so an empty drain cannot trip on them.
+    for(auto& counter:g_counters_awaiting_submit)
+        if(!counter->published.load(std::memory_order_acquire))
+            counter->published.store(true,std::memory_order_release),++g_counters_fast_provisional;
+    g_counters_awaiting_submit.clear();
+    if(g_pending_submissions.empty()) {
+        if(!g_pending_counters.empty())fail("pending counter records have no in-flight submission");
+        return;
+    }
+    uint64_t last_serial=0;
+    size_t kept=0;
+    for(size_t i=0;i<g_pending_submissions.size();++i) {
+        auto& submission=g_pending_submissions[i];
+        // Present command buffers only touch the drawable and internal upscale/HUD textures, never
+        // guest memory. Cpu-read and uniform-update hazards cannot involve them, so those drains
+        // skip the display wait and let the next frame's encoding overlap it; the next full drain
+        // (present, submit, counter or explicit wait) retires the deferred submissions.
+        if(!wait_presents&&submission.reason==CommitReason::Present) {
+            g_pending_submissions[kept++]=std::move(submission);
+            continue;
+        }
+        uint64_t wait_ns=0;
+        if(dispatch_semaphore_wait(submission.completed,DISPATCH_TIME_NOW)) {
+            const uint64_t wait_started=plat::monotonic_ns();
+            if(wait_started>=submission.deadline_ns)fail("GPU command did not complete within 2 seconds");
+            const uint64_t remaining=submission.deadline_ns-wait_started;
+            if(dispatch_semaphore_wait(submission.completed,dispatch_time(DISPATCH_TIME_NOW,int64_t(remaining))))
+                fail("GPU command did not complete within 2 seconds");
+            wait_ns=plat::monotonic_ns()-wait_started;
+        }
+        if(submission.command.status!=MTLCommandBufferStatusCompleted)
+            fail("GPU command failed: "+error_text(submission.command.error));
+        auto& timing=g_commit_timing[size_t(submission.reason)];
+        timing.wait_ns+=wait_ns;
+        const double gpu_start=submission.command.GPUStartTime,gpu_end=submission.command.GPUEndTime;
+        if(std::isfinite(gpu_start)&&std::isfinite(gpu_end)&&gpu_start>0&&gpu_end>=gpu_start) {
+            timing.gpu_seconds+=gpu_end-gpu_start;++timing.gpu_samples;
+        }
+        // Timestamp counters publish provisionally at encode time; this submission has completed, so
+        // backfill its counters with its GPUEndTime (never moving a record backwards) and publish.
+        // Legacy counters published themselves from the shared-event callback. Same-address records
+        // may transiently step back within one drain; fence-gated readers never observe that window.
+        for(auto& counter:submission.counters) {
+            if(counter->published.load(std::memory_order_acquire)||counter->legacy)continue;
+            uint64_t value=counter->encode_ns;
+            if(std::isfinite(gpu_end)&&gpu_end>0) {value=std::max(value,uint64_t(gpu_end*1e9));++g_counters_fast_gpu;}
+            else ++g_counters_fast_provisional;
+            const uint64_t record[2]={counter->sequence,value};
+            std::memcpy(counter->host_address,record,sizeof record);
+            counter->published.store(true,std::memory_order_release);
+        }
+        last_serial=submission.serial;
+    }
+    if(kept) {
+        g_pending_submissions.erase(g_pending_submissions.begin()+kept,g_pending_submissions.end());
+        // Deferred present submissions still own their counters and snapshot buffers; the strict
+        // published check, counter retirement and snapshot recycling wait for the next full drain.
+        if(last_serial)g_completed=last_serial;
+        g_pending_buffer_writes=false;
+        return;
+    }
+    for (const auto& counter : g_pending_counters)
+        if (!counter->published.load(std::memory_order_acquire))
+            fail("GPU command completed before a counter record was published");
+    g_pending_counters.clear();
+    g_completed=last_serial;
+    g_pending_submissions.clear();
+    recycle_snapshot_buffers();
+    g_alias_reads.clear();
+    g_gpu_write_intervals.clear();
+    g_pending_buffer_writes=false;
+}
+void commit_wait(CommitReason reason) {
+    end_encoding();
+    submit_current(reason);
+    // Present completion is the display deadline and is never a guest-memory hazard for cpu reads
+    // or uniform updates; those two skip it so encoding overlaps the display wait.
+    drain_submissions(reason!=CommitReason::CpuRead&&reason!=CommitReason::BufferUpdate);
+}
+enum class CpuReadSite : size_t { Draw, Dispatch, Clear, Copy, Count };
+void prepare_cpu_reads(CpuReadSite site) {
+    if(!g_pending_buffer_writes)return;
