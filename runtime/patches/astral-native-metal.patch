diff --git a/runtime/src/nvn/metal_clear.inc b/runtime/src/nvn/metal_clear.inc
new file mode 100644
--- /dev/null
+++ b/runtime/src/nvn/metal_clear.inc
@@ -0,0 +1,217 @@
+// Pipeline-backed NVN clears. Included inside nvn_metal.mm's anonymous namespace after the format helpers.
+// Load/store actions cannot express a scissor rectangle or preserve selected color/stencil bits, so those clears
+// rasterize a full-target triangle under the NVN scissor with the corresponding write masks.
+
+struct ClearParams {
+    float color[4] = {};
+    float depth = 0;
+    float padding[3] = {};
+};
+static_assert(sizeof(ClearParams) == 32);
+
+bool integer_color_format(MTLPixelFormat format) {
+    switch (format) {
+        case MTLPixelFormatR8Uint: case MTLPixelFormatR8Sint:
+        case MTLPixelFormatRG8Uint: case MTLPixelFormatRG8Sint:
+        case MTLPixelFormatRGBA8Uint: case MTLPixelFormatRGBA8Sint:
+        case MTLPixelFormatR16Uint: case MTLPixelFormatR16Sint:
+        case MTLPixelFormatRG16Uint: case MTLPixelFormatRG16Sint:
+        case MTLPixelFormatRGBA16Uint: case MTLPixelFormatRGBA16Sint:
+        case MTLPixelFormatR32Uint: case MTLPixelFormatR32Sint:
+        case MTLPixelFormatRG32Uint: case MTLPixelFormatRG32Sint:
+        case MTLPixelFormatRGBA32Uint: case MTLPixelFormatRGBA32Sint:
+        case MTLPixelFormatRGB10A2Uint:
+            return true;
+        default:
+            return false;
+    }
+}
+
+MTLColorWriteMask clear_color_write_mask(uint32_t mask) {
+    MTLColorWriteMask out = MTLColorWriteMaskNone;
+    if (mask & 1) out |= MTLColorWriteMaskRed;
+    if (mask & 2) out |= MTLColorWriteMaskGreen;
+    if (mask & 4) out |= MTLColorWriteMaskBlue;
+    if (mask & 8) out |= MTLColorWriteMaskAlpha;
+    return out;
+}
+
+id<MTLLibrary> clear_library() {
+    static id<MTLLibrary> library;
+    if (library) return library;
+    static const char* source = R"METAL(
+#include <metal_stdlib>
+using namespace metal;
+struct P { float4 color; float depth; };
+struct V { float4 position [[position]]; };
+vertex V ac_clear_vertex(uint id [[vertex_id]], constant P& p [[buffer(0)]]) {
+    float2 xy = float2((id << 1) & 2, id & 2);
+    V out; out.position = float4(xy * 2.0 - 1.0, p.depth, 1.0); return out;
+}
+fragment float4 ac_clear_color(V in [[stage_in]], constant P& p [[buffer(0)]]) { return p.color; }
+fragment void ac_clear_depth_stencil(V in [[stage_in]]) {}
+)METAL";
+    NSError* error = nil;
+    library = [g_device newLibraryWithSource:[NSString stringWithUTF8String:source] options:nil error:&error];
+    if (!library) fail("native clear shader: " + error_text(error));
+    return library;
+}
+
+id<MTLRenderPipelineState> clear_color_pipeline(MTLPixelFormat format, NSUInteger samples, uint32_t mask) {
+    using Key = std::tuple<uint32_t, NSUInteger, uint32_t>;
+    static std::map<Key, id<MTLRenderPipelineState>> cache;
+    Key key{uint32_t(format), samples, mask & 15};
+    if (auto i = cache.find(key); i != cache.end()) return i->second;
+    auto library = clear_library();
+    auto* descriptor = [MTLRenderPipelineDescriptor new];
+    descriptor.vertexFunction = [library newFunctionWithName:@"ac_clear_vertex"];
+    descriptor.fragmentFunction = [library newFunctionWithName:@"ac_clear_color"];
+    descriptor.colorAttachments[0].pixelFormat = format;
+    descriptor.colorAttachments[0].writeMask = clear_color_write_mask(mask);
+    descriptor.rasterSampleCount = samples;
+    NSError* error = nil;
+    id<MTLRenderPipelineState> pipeline = [g_device newRenderPipelineStateWithDescriptor:descriptor error:&error];
+    if (!pipeline) fail("native color-clear pipeline: " + error_text(error));
+    cache.emplace(key, pipeline);
+    return pipeline;
+}
+
+id<MTLRenderPipelineState> clear_depth_stencil_pipeline(MTLPixelFormat format, NSUInteger samples) {
+    using Key = std::pair<uint32_t, NSUInteger>;
+    static std::map<Key, id<MTLRenderPipelineState>> cache;
+    Key key{uint32_t(format), samples};
+    if (auto i = cache.find(key); i != cache.end()) return i->second;
+    auto library = clear_library();
+    auto* descriptor = [MTLRenderPipelineDescriptor new];
+    descriptor.vertexFunction = [library newFunctionWithName:@"ac_clear_vertex"];
+    descriptor.fragmentFunction = [library newFunctionWithName:@"ac_clear_depth_stencil"];
+    if (has_depth(format)) descriptor.depthAttachmentPixelFormat = format;
+    if (has_stencil(format)) descriptor.stencilAttachmentPixelFormat = format;
+    descriptor.rasterSampleCount = samples;
+    NSError* error = nil;
+    id<MTLRenderPipelineState> pipeline = [g_device newRenderPipelineStateWithDescriptor:descriptor error:&error];
+    if (!pipeline) fail("native depth/stencil-clear pipeline: " + error_text(error));
+    cache.emplace(key, pipeline);
+    return pipeline;
+}
+
+id<MTLDepthStencilState> clear_depth_stencil_state(MTLPixelFormat format, bool clear_depth, uint32_t stencil_mask) {
+    using Key = std::tuple<uint32_t, bool, uint32_t>;
+    static std::map<Key, id<MTLDepthStencilState>> cache;
+    Key key{uint32_t(format), clear_depth, stencil_mask & 255};
+    if (auto i = cache.find(key); i != cache.end()) return i->second;
+    auto* descriptor = [MTLDepthStencilDescriptor new];
+    descriptor.depthCompareFunction = MTLCompareFunctionAlways;
+    descriptor.depthWriteEnabled = clear_depth;
+    if (stencil_mask) {
+        auto* stencil = [MTLStencilDescriptor new];
+        stencil.stencilCompareFunction = MTLCompareFunctionAlways;
+        stencil.stencilFailureOperation = MTLStencilOperationKeep;
+        stencil.depthFailureOperation = MTLStencilOperationKeep;
+        stencil.depthStencilPassOperation = MTLStencilOperationReplace;
+        stencil.readMask = 255;
+        stencil.writeMask = stencil_mask & 255;
+        descriptor.frontFaceStencil = stencil;
+        descriptor.backFaceStencil = stencil;
+    }
+    id<MTLDepthStencilState> state = [g_device newDepthStencilStateWithDescriptor:descriptor];
+    if (!state) fail("native depth/stencil-clear state creation failed");
+    cache.emplace(key, state);
+    return state;
+}
+
+MTLScissorRect clear_scissor(const replay::State& state, NSUInteger width, NSUInteger height) {
+    int64_t x = state.has_scissor ? state.scissor[0] : 0;
+    int64_t y = state.has_scissor ? state.scissor[1] : 0;
+    int64_t right = state.has_scissor ? x + int64_t(state.scissor[2]) : int64_t(width);
+    int64_t bottom = state.has_scissor ? y + int64_t(state.scissor[3]) : int64_t(height);
+    x = std::clamp<int64_t>(x, 0, int64_t(width));
+    y = std::clamp<int64_t>(y, 0, int64_t(height));
+    right = std::clamp<int64_t>(right, x, int64_t(width));
+    bottom = std::clamp<int64_t>(bottom, y, int64_t(height));
+    return MTLScissorRect{NSUInteger(x), NSUInteger(y), NSUInteger(right - x), NSUInteger(bottom - y)};
+}
+
+bool masked_clear(const Cmd& c, id<MTLTexture> target, uint64_t guest, const ViewInfo& view) {
+    end_encoding();
+    if (!target || !target.width || !target.height) fail("native clear has an invalid attachment");
+    const replay::State& state = replay::g_state;
+    MTLScissorRect scissor = clear_scissor(state, target.width, target.height);
+    if (!scissor.width || !scissor.height) return false;
+
+    ClearParams params{};
+    params.color[0] = c.f[0]; params.color[1] = c.f[1];
+    params.color[2] = c.f[2]; params.color[3] = c.f[3];
+    params.depth = std::clamp(c.f[0], 0.0f, 1.0f);
+    auto* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    id<MTLRenderPipelineState> pipeline = nil;
+    id<MTLDepthStencilState> depth_state = nil;
+    bool clear_depth = false;
+    uint32_t stencil_mask = 0;
+
+    if (c.op == Cmd::ClearColor) {
+        if (has_depth(target.pixelFormat) || has_stencil(target.pixelFormat))
+            fail("native color clear cannot target a depth/stencil attachment");
+        if (integer_color_format(target.pixelFormat))
+            fail("native masked clear does not support integer color attachments");
+        uint32_t color_mask = c.mask & 15;
+        if (!color_mask) return false;
+        bool fresh=!subresource_initialized(guest,&view,TextureColor);
+        pass.colorAttachments[0].texture = target;
+        pass.colorAttachments[0].loadAction = fresh?MTLLoadActionClear:MTLLoadActionLoad;
+        pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+        if(fresh)pass.colorAttachments[0].clearColor=MTLClearColorMake(0,0,0,0);
+        pipeline = clear_color_pipeline(target.pixelFormat, target.sampleCount, color_mask);
+    } else if (c.op == Cmd::ClearDepthStencil) {
+        if (!has_depth(target.pixelFormat) && !has_stencil(target.pixelFormat))
+            fail("native depth/stencil clear cannot target a color attachment");
+        clear_depth = (c.mask & 1) != 0;
+        stencil_mask = (c.mask >> 8) & 255;
+        if (has_depth(target.pixelFormat)) {
+            bool fresh=!subresource_initialized(guest,&view,TextureDepth);
+            pass.depthAttachment.texture = target;
+            pass.depthAttachment.loadAction = fresh?MTLLoadActionClear:MTLLoadActionLoad;
+            pass.depthAttachment.storeAction = MTLStoreActionStore;
+            pass.depthAttachment.clearDepth=1.0;
+        } else if (clear_depth) {
+            fail("native depth clear requested for a stencil-only attachment");
+        }
+        if (has_stencil(target.pixelFormat)) {
+            bool fresh=!subresource_initialized(guest,&view,TextureStencil);
+            pass.stencilAttachment.texture = target;
+            pass.stencilAttachment.loadAction = fresh?MTLLoadActionClear:MTLLoadActionLoad;
+            pass.stencilAttachment.storeAction = MTLStoreActionStore;
+            pass.stencilAttachment.clearStencil=0;
+        } else if (stencil_mask) {
+            fail("native stencil clear requested for a depth-only attachment");
+        }
+        if (!clear_depth && !stencil_mask) return false;
+        pipeline = clear_depth_stencil_pipeline(target.pixelFormat, target.sampleCount);
+        depth_state = clear_depth_stencil_state(target.pixelFormat, clear_depth, stencil_mask);
+    } else {
+        fail("native masked_clear received an unsupported command");
+    }
+
+    pass.renderTargetWidth = target.width;
+    pass.renderTargetHeight = target.height;
+    id<MTLRenderCommandEncoder> encoder = [command_buffer() renderCommandEncoderWithDescriptor:pass];
+    if (!encoder) fail("native masked-clear render encoder creation failed");
+    [encoder setRenderPipelineState:pipeline];
+    [encoder setViewport:MTLViewport{0, 0, double(target.width), double(target.height), 0, 1}];
+    [encoder setScissorRect:scissor];
+    if (c.op == Cmd::ClearColor) {
+        [encoder setVertexBytes:&params length:sizeof params atIndex:0];
+        [encoder setFragmentBytes:&params length:sizeof params atIndex:0];
+    } else {
+        [encoder setDepthStencilState:depth_state];
+        uint32_t reference = uint32_t(c.i[0]) & 255;
+        [encoder setStencilFrontReferenceValue:reference backReferenceValue:reference];
+        [encoder setVertexBytes:&params length:sizeof params atIndex:0];
+    }
+    [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [encoder endEncoding];
+    uint8_t aspects=c.op==Cmd::ClearColor?TextureColor:
+        uint8_t((has_depth(target.pixelFormat)?TextureDepth:0)|(has_stencil(target.pixelFormat)?TextureStencil:0));
+    mark_rendered(guest,&view,aspects);
+    return true;
+}
