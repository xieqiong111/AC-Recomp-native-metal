+
+// NVN format numbers are the SDK table indices used by nvn_format.cpp. This maps them directly to Metal so the native
+// backend never asks the Vulkan runtime to translate or create a resource.
+Format format_for(uint32_t f) {
+    Format out{};
+    switch (f) {
+        case 0x01: out.pixel = MTLPixelFormatR8Unorm; break;
+        case 0x02: out.pixel = MTLPixelFormatR8Snorm; break;
+        case 0x03: out.pixel = MTLPixelFormatR8Uint; break;
+        case 0x04: out.pixel = MTLPixelFormatR8Sint; break;
+        case 0x05: out.pixel = MTLPixelFormatR16Float; break;
+        case 0x06: out.pixel = MTLPixelFormatR16Unorm; break;
+        case 0x07: out.pixel = MTLPixelFormatR16Snorm; break;
+        case 0x08: out.pixel = MTLPixelFormatR16Uint; break;
+        case 0x09: out.pixel = MTLPixelFormatR16Sint; break;
+        case 0x0a: out.pixel = MTLPixelFormatR32Float; break;
+        case 0x0b: out.pixel = MTLPixelFormatR32Uint; break;
+        case 0x0c: out.pixel = MTLPixelFormatR32Sint; break;
+        case 0x0d: out.pixel = MTLPixelFormatRG8Unorm; break;
+        case 0x0e: out.pixel = MTLPixelFormatRG8Snorm; break;
+        case 0x0f: out.pixel = MTLPixelFormatRG8Uint; break;
+        case 0x10: out.pixel = MTLPixelFormatRG8Sint; break;
+        case 0x11: out.pixel = MTLPixelFormatRG16Float; break;
+        case 0x12: out.pixel = MTLPixelFormatRG16Unorm; break;
+        case 0x13: out.pixel = MTLPixelFormatRG16Snorm; break;
+        case 0x14: out.pixel = MTLPixelFormatRG16Uint; break;
+        case 0x15: out.pixel = MTLPixelFormatRG16Sint; break;
+        case 0x16: out.pixel = MTLPixelFormatRG32Float; break;
+        case 0x17: out.pixel = MTLPixelFormatRG32Uint; break;
+        case 0x18: out.pixel = MTLPixelFormatRG32Sint; break;
+        case 0x19: out.pixel = MTLPixelFormatRGBA8Unorm; out.rgb = true; break;
+        case 0x1a: out.pixel = MTLPixelFormatRGBA8Snorm; out.rgb = true; break;
+        case 0x1b: out.pixel = MTLPixelFormatRGBA8Uint; out.rgb = true; break;
+        case 0x1c: out.pixel = MTLPixelFormatRGBA8Sint; out.rgb = true; break;
+        case 0x1d: out.pixel = MTLPixelFormatRGBA16Float; out.rgb = true; break;
+        case 0x1e: out.pixel = MTLPixelFormatRGBA16Unorm; out.rgb = true; break;
+        case 0x1f: out.pixel = MTLPixelFormatRGBA16Snorm; out.rgb = true; break;
+        case 0x20: out.pixel = MTLPixelFormatRGBA16Uint; out.rgb = true; break;
+        case 0x21: out.pixel = MTLPixelFormatRGBA16Sint; out.rgb = true; break;
+        case 0x22: out.pixel = MTLPixelFormatRGBA32Float; out.rgb = true; break;
+        case 0x23: out.pixel = MTLPixelFormatRGBA32Uint; out.rgb = true; break;
+        case 0x24: out.pixel = MTLPixelFormatRGBA32Sint; out.rgb = true; break;
+        case 0x25: out.pixel = MTLPixelFormatRGBA8Unorm; break;
+        case 0x26: out.pixel = MTLPixelFormatRGBA8Snorm; break;
+        case 0x27: out.pixel = MTLPixelFormatRGBA8Uint; break;
+        case 0x28: out.pixel = MTLPixelFormatRGBA8Sint; break;
+        case 0x29: out.pixel = MTLPixelFormatRGBA16Float; break;
+        case 0x2a: out.pixel = MTLPixelFormatRGBA16Unorm; break;
+        case 0x2b: out.pixel = MTLPixelFormatRGBA16Snorm; break;
+        case 0x2c: out.pixel = MTLPixelFormatRGBA16Uint; break;
+        case 0x2d: out.pixel = MTLPixelFormatRGBA16Sint; break;
+        case 0x2e: out.pixel = MTLPixelFormatRGBA32Float; break;
+        case 0x2f: out.pixel = MTLPixelFormatRGBA32Uint; break;
+        case 0x30: out.pixel = MTLPixelFormatRGBA32Sint; break;
+        case 0x31: out.pixel = MTLPixelFormatStencil8; break;
+        case 0x32: out.pixel = MTLPixelFormatDepth16Unorm; break;
+        case 0x33: out.pixel = MTLPixelFormatDepth32Float; break;  // NVN D24 is represented as D32 on the host.
+        case 0x34: out.pixel = MTLPixelFormatDepth32Float; break;
+        case 0x35: case 0x36: out.pixel = MTLPixelFormatDepth32Float_Stencil8; break;
+        case 0x37: case 0x38: out.pixel = MTLPixelFormatRGBA8Unorm_sRGB; out.srgb = true; break;
+        case 0x39: out.pixel = MTLPixelFormatABGR4Unorm; break;
+        case 0x3a: out.pixel = MTLPixelFormatA1BGR5Unorm; break;
+        case 0x3b: out.pixel = MTLPixelFormatBGR5A1Unorm; break;
