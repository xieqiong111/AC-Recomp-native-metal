+    std::function<int(const std::shared_ptr<CmdList>&, int)> scan;
+    scan = [&](const std::shared_ptr<CmdList>& list, int depth) -> int {
+        if (!list) fatal("native Metal: null command list at submit capture");
+        if (depth > 32) fatal("native Metal: command-list recursion limit exceeded at submit capture");
+        if (auto found = heights.find(list.get()); found != heights.end()) {
+            if (depth + found->second > 32) fatal("native Metal: command-list recursion limit exceeded at submit capture");
+            return found->second;
+        }
+        if (!active.insert(list.get()).second) fatal("native Metal: cyclic command list at submit capture");
+        snapshot->epoch = std::max(snapshot->epoch, list->epoch);
+        int height = 0;
+        for (const Cmd& command : list->cmds) {
+            if (command.op == Cmd::CallList) {
+                auto found = snapshot->called.find(command.a[0]);
+                std::shared_ptr<CmdList> child = found == snapshot->called.end() ? command_list(command.a[0]) : found->second;
+                if (!child) fatal("native Metal: unknown called command list at submit capture");
+                snapshot->called.emplace(command.a[0], child);
+                height = std::max(height, 1 + scan(child, depth + 1));
+            } else if (command.op == Cmd::BindDeferred) {
+                const uint32_t limits[] = {32, 16, 18, 16};
+                if (command.mask >= 4 || command.i[0] < 0 || command.i[0] >= 6 || command.i[1] < 0 ||
+                    uint32_t(command.i[1]) > limits[command.mask] ||
+                    command.n > limits[command.mask] - uint32_t(command.i[1]))
+                    fatal("native Metal: invalid deferred binding at submit capture");
+                const size_t words = size_t(command.n) * (command.mask >= 2 ? 2 : 1);
+                if (words && (!command.a[0] || command.a[0] > UINT64_MAX - words * sizeof(uint64_t)))
+                    fatal("native Metal: invalid deferred array range at submit capture");
+                if (words) extents[command.a[0]] = std::max(extents[command.a[0]], words);
+            }
+        }
+        active.erase(list.get());
+        heights.emplace(list.get(), height);
+        return height;
+    };
+    for (const auto& list : lists) scan(list, 0);
+    // First collect maximum extents, then read each source once before the caller may reuse it.
+    for (const auto& [address, words] : extents) {
+        auto& values = snapshot->deferred[address];
+        values.resize(words);
+        for (size_t word = 0; word < words; ++word) values[word] = ld<uint64_t>(address + word * sizeof(uint64_t));
+    }
