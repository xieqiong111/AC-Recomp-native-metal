+        case 0x3d: out.pixel = MTLPixelFormatRGB10A2Unorm; break;
+        case 0x3e: out.pixel = MTLPixelFormatRGB10A2Uint; break;
+        case 0x3f: out.pixel = MTLPixelFormatRG11B10Float; break;
+        case 0x40: out.pixel = MTLPixelFormatRGB9E5Float; break;
+        case 0x41: out.pixel = MTLPixelFormatBC1_RGBA; out.compressed = out.bc = true; break;
+        case 0x42: out.pixel = MTLPixelFormatBC1_RGBA; out.compressed = out.bc = true; break;
+        case 0x43: out.pixel = MTLPixelFormatBC2_RGBA; out.compressed = out.bc = true; break;
+        case 0x44: out.pixel = MTLPixelFormatBC3_RGBA; out.compressed = out.bc = true; break;
+        case 0x45: out.pixel = MTLPixelFormatBC1_RGBA_sRGB; out.srgb = out.compressed = out.bc = true; break;
+        case 0x46: out.pixel = MTLPixelFormatBC1_RGBA_sRGB; out.srgb = out.compressed = out.bc = true; break;
+        case 0x47: out.pixel = MTLPixelFormatBC2_RGBA_sRGB; out.srgb = out.compressed = out.bc = true; break;
+        case 0x48: out.pixel = MTLPixelFormatBC3_RGBA_sRGB; out.srgb = out.compressed = out.bc = true; break;
+        case 0x49: out.pixel = MTLPixelFormatBC4_RUnorm; out.compressed = out.bc = true; break;
+        case 0x4a: out.pixel = MTLPixelFormatBC4_RSnorm; out.compressed = out.bc = true; break;
+        case 0x4b: out.pixel = MTLPixelFormatBC5_RGUnorm; out.compressed = out.bc = true; break;
+        case 0x4c: out.pixel = MTLPixelFormatBC5_RGSnorm; out.compressed = out.bc = true; break;
+        case 0x4d: out.pixel = MTLPixelFormatBC7_RGBAUnorm; out.compressed = out.bc = true; break;
+        case 0x4e: out.pixel = MTLPixelFormatBC7_RGBAUnorm_sRGB; out.srgb = out.compressed = out.bc = true; break;
+        case 0x4f: out.pixel = MTLPixelFormatBC6H_RGBFloat; out.compressed = out.bc = true; break;
+        case 0x50: out.pixel = MTLPixelFormatBC6H_RGBUfloat; out.compressed = out.bc = true; break;
+        case 0x79: out.pixel = MTLPixelFormatASTC_4x4_LDR; out.compressed = out.astc = true; break;
+        case 0x7a: out.pixel = MTLPixelFormatASTC_5x4_LDR; out.compressed = out.astc = true; break;
+        case 0x7b: out.pixel = MTLPixelFormatASTC_5x5_LDR; out.compressed = out.astc = true; break;
+        case 0x7c: out.pixel = MTLPixelFormatASTC_6x5_LDR; out.compressed = out.astc = true; break;
+        case 0x7d: out.pixel = MTLPixelFormatASTC_6x6_LDR; out.compressed = out.astc = true; break;
+        case 0x7e: out.pixel = MTLPixelFormatASTC_8x5_LDR; out.compressed = out.astc = true; break;
+        case 0x7f: out.pixel = MTLPixelFormatASTC_8x6_LDR; out.compressed = out.astc = true; break;
+        case 0x80: out.pixel = MTLPixelFormatASTC_8x8_LDR; out.compressed = out.astc = true; break;
+        case 0x81: out.pixel = MTLPixelFormatASTC_10x5_LDR; out.compressed = out.astc = true; break;
+        case 0x82: out.pixel = MTLPixelFormatASTC_10x6_LDR; out.compressed = out.astc = true; break;
+        case 0x83: out.pixel = MTLPixelFormatASTC_10x8_LDR; out.compressed = out.astc = true; break;
+        case 0x84: out.pixel = MTLPixelFormatASTC_10x10_LDR; out.compressed = out.astc = true; break;
+        case 0x85: out.pixel = MTLPixelFormatASTC_12x10_LDR; out.compressed = out.astc = true; break;
+        case 0x86: out.pixel = MTLPixelFormatASTC_12x12_LDR; out.compressed = out.astc = true; break;
+        case 0x87: out.pixel = MTLPixelFormatASTC_4x4_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x88: out.pixel = MTLPixelFormatASTC_5x4_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x89: out.pixel = MTLPixelFormatASTC_5x5_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x8a: out.pixel = MTLPixelFormatASTC_6x5_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x8b: out.pixel = MTLPixelFormatASTC_6x6_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x8c: out.pixel = MTLPixelFormatASTC_8x5_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x8d: out.pixel = MTLPixelFormatASTC_8x6_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x8e: out.pixel = MTLPixelFormatASTC_8x8_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x8f: out.pixel = MTLPixelFormatASTC_10x5_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x90: out.pixel = MTLPixelFormatASTC_10x6_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x91: out.pixel = MTLPixelFormatASTC_10x8_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x92: out.pixel = MTLPixelFormatASTC_10x10_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x93: out.pixel = MTLPixelFormatASTC_12x10_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x94: out.pixel = MTLPixelFormatASTC_12x12_sRGB; out.srgb = out.compressed = out.astc = true; break;
+        case 0x95: out.pixel = MTLPixelFormatB5G6R5Unorm; break;
+        case 0x96: case 0x97: out.pixel = MTLPixelFormatBGR5A1Unorm; break;
+        case 0x98: out.pixel = MTLPixelFormatA1BGR5Unorm; break;
+        case 0x99: case 0x9a: out.pixel = MTLPixelFormatBGRA8Unorm; break;
+        case 0x9b: case 0x9c: out.pixel = MTLPixelFormatBGRA8Unorm_sRGB; out.srgb = true; break;
+        default: break;
+    }
+    if (out.pixel == MTLPixelFormatInvalid) return out;
+    format_block(f, out.block_width, out.block_height, out.bytes);
+    out.compressed = out.compressed || out.block_width > 1 || out.block_height > 1;
+    return out;
+}
+
+uint32_t rgb_expansion_format(uint32_t f) {
+    switch (f) {
+        case 0x19: return 0x25;  // RGB8 UNORM -> RGBA8 UNORM
+        case 0x1a: return 0x26;
+        case 0x1b: return 0x27;
+        case 0x1c: return 0x28;
+        case 0x1d: return 0x29;
+        case 0x1e: return 0x2a;
+        case 0x1f: return 0x2b;
+        case 0x20: return 0x2c;
+        case 0x21: return 0x2d;
+        case 0x22: return 0x2e;
+        case 0x23: return 0x2f;
+        case 0x24: return 0x30;
+        default: return f;
+    }
+}
+
+bool is_bc_rgb(uint32_t f) { return f == 0x41 || f == 0x45; }
+bool is_depth_stencil_format(uint32_t f) { return f >= 0x31 && f <= 0x36; }
+uint32_t bc_output_format(uint32_t f) {
+    if (f == 0x49) return 0x01;
+    if (f == 0x4a) return 0x02;
+    if (f == 0x4b) return 0x0d;
+    if (f == 0x4c) return 0x0e;
+    if (f == 0x45 || f == 0x46 || f == 0x47 || f == 0x48 || f == 0x4e) return 0x38;
+    return 0x25;
+}
+
+uint32_t host_format(uint32_t f, bool decoded_bc, bool decoded_astc) {
+    if (decoded_bc) return bc_output_format(f);
+    if (decoded_astc) return f >= 0x87 ? 0x38 : 0x25;
+    return rgb_expansion_format(f);
+}
+
+uint32_t total_layers(const Texture& t) {
+    switch (t.target) {
+        case 3: return std::max(1u, t.depth <= 1 ? t.height : t.depth);  // NVN 1D-array depth may be in height.
+        case 4: case 6: return std::max(1u, t.depth);
+        case 8: return 6;
+        case 9: return std::max(6u, t.depth);
+        default: return 1;
+    }
+}
+
+uint32_t mip_count(const Texture& t) {
+    uint32_t count = std::max(1u, t.levels);
+    uint32_t size = std::max({1u, t.width, (t.target == 0 || t.target == 3) ? 1u : t.height,
+                              t.target == 2 ? t.depth : 1u});
+    uint32_t max_levels = 1;
+    while (size >>= 1) ++max_levels;
+    return std::min(count, max_levels);
+}
+
+MTLTextureType texture_type(const Texture& t) {
+    switch (t.target) {
+        case 0: return MTLTextureType1D;
+        case 2: return MTLTextureType3D;
+        case 3: return MTLTextureType1DArray;
+        case 4: return MTLTextureType2DArray;
+        case 5: return MTLTextureType2DMultisample;
+        case 6: return MTLTextureType2DMultisampleArray;
+        case 8: return MTLTextureTypeCube;
+        case 9: return MTLTextureTypeCubeArray;
+        case 1: return MTLTextureType2D;
+        case 7: return MTLTextureType2D; // NVN rectangle textures use the 2D Metal texture path.
+        default: return MTLTextureType2D;
+    }
+}
+
+MTLTextureType view_type(const Texture& t, const ImageShape* shape) {
+    if (!shape) return texture_type(t);
+    if (shape->ms) {
+        if (shape->dim != 1 || shape->arrayed) {
+            if (shape->dim != 1) fail("Metal texture: unsupported multisample image dimension");
+            return MTLTextureType2DMultisampleArray;
+        }
+        return MTLTextureType2DMultisample;
+    }
+    switch (shape->dim) {
+        case 0: return shape->arrayed ? MTLTextureType1DArray : MTLTextureType1D;
+        case 1: return shape->arrayed ? MTLTextureType2DArray : MTLTextureType2D;
+        case 2:
+            if (shape->arrayed) fail("Metal texture: 3D array views are unsupported");
+            return MTLTextureType3D;
+        case 3: return shape->arrayed ? MTLTextureTypeCubeArray : MTLTextureTypeCube;
+        case 5: return MTLTextureTypeTextureBuffer;
+        default: fail("Metal texture: unsupported reflected image dimension");
+    }
+}
+
+MTLTextureSwizzle swizzle(uint8_t c) {
+    switch (c) {
+        case 0: return MTLTextureSwizzleZero;
+        case 1: return MTLTextureSwizzleOne;
+        case 2: return MTLTextureSwizzleRed;
+        case 3: return MTLTextureSwizzleGreen;
+        case 4: return MTLTextureSwizzleBlue;
+        case 5: return MTLTextureSwizzleAlpha;
+        default: fail("Metal texture: invalid NVN swizzle component");
+    }
+}
+
+MTLTextureSwizzleChannels view_swizzle(const Texture& t, const ViewInfo* view) {
+    const uint32_t logical_format = view && view->format ? view->format : t.format;
+    const bool force_one_alpha = emulated_no_alpha(logical_format);
+    auto channel = [force_one_alpha](uint8_t selector) {
+        return swizzle(force_one_alpha && selector == 5 ? 1 : selector);
+    };
+    uint32_t packed = view && view->swizzle ? view->swizzle : t.pool_swizzle.load(std::memory_order_acquire);
+    if (!packed) {
+        MTLTextureSwizzleChannels result{};
+        result.red = channel(t.swizzle[0]);
+        result.green = channel(t.swizzle[1]);
+        result.blue = channel(t.swizzle[2]);
+        result.alpha = channel(t.swizzle[3]);
+        return result;
+    }
+    return {channel(uint8_t(packed)), channel(uint8_t(packed >> 8)), channel(uint8_t(packed >> 16)),
+            channel(uint8_t(packed >> 24))};
+}
+
+std::string texture_context(uint64_t guest, const Texture& t) {
+    std::ostringstream s;
+    s << "Metal texture " << std::hex << guest << " format 0x" << t.format << std::dec << " " << t.width << "x"
+      << t.height << "x" << t.depth;
+    return s.str();
+}
+
+uint64_t align_up(uint64_t x, uint64_t a) {
+    if (!a || x > UINT64_MAX - (a - 1)) fail("Metal resource: size overflow while aligning");
+    return (x + a - 1) / a * a;
+}
+
+struct AliasKey {
+    uintptr_t address = 0;
+    NSUInteger length = 0;
+    bool operator<(const AliasKey& o) const { return std::tie(address, length) < std::tie(o.address, o.length); }
+};
+
+struct AliasEntry { __strong id<MTLBuffer> object = nil; };
+std::map<AliasKey, AliasEntry> g_aliases;
+std::mutex g_alias_mutex;
+
+struct HostRange { uintptr_t address = 0, segment_begin = 0; uint64_t segment_size = 0; };
+
+HostRange host_range(uint64_t gpu_address, uint64_t size) {
+    std::shared_lock object_guard(objects_lock());
+    uint64_t offset = 0;
+    MemoryPool* pool = pool_at_gpu(gpu_address, &offset);
+    if (!pool || !size || offset > pool->size || size > pool->size - offset)
+        fail("Metal buffer: GPU address is not inside a mapped NVN memory pool");
+    if (pool->memory) {
+        uintptr_t resolved = uintptr_t(pool->memory + offset);
+        return {resolved, uintptr_t(pool->memory), pool->size};
+    }
+    auto it = pool->mappings.upper_bound(offset);
+    if (it == pool->mappings.begin()) fail("Metal buffer: virtual NVN pool range has no physical mapping");
+    --it;
+    const auto& mapping = it->second;
+    uint64_t delta = offset - it->first;
+    if (delta > mapping.size || size > mapping.size - delta)
+        fail("Metal buffer: range crosses a virtual-pool mapping boundary");
+    const auto& object_map = objects();
+    auto physical = object_map.find(mapping.physical);
+    auto* backing = physical == object_map.end() ? nullptr : dynamic_cast<MemoryPool*>(physical->second.get());
+    if (!backing || !backing->memory || mapping.physical_offset > backing->size || mapping.size > backing->size - mapping.physical_offset)
+        fail("Metal buffer: virtual-pool backing is not a CPU-mapped physical pool");
+    uintptr_t segment = uintptr_t(backing->memory + mapping.physical_offset);
+    uintptr_t resolved = segment + delta;
+    return {resolved, segment, mapping.size};
+}
+
+struct LevelData {
+    uint64_t offset = 0, layer_size = 0, row_bytes = 0, image_bytes = 0;
+    uint32_t width = 0, height = 0, slices = 1;
+};
+
+std::vector<LevelData> read_texture_bytes(const Texture& t, const uint8_t* source, const Format& format,
+                                          std::vector<uint8_t>& bytes) {
+    if (!source) fail("Metal texture: upload source is not CPU mapped");
+    const uint32_t layers = t.target == 2 ? std::max(1u, t.depth) : total_layers(t);
+    const uint32_t levels = mip_count(t);
+    if (t.target == 2 && levels > 1)
+        fail(texture_context(0, t) + ": CPU upload of a 3D mip chain is unsupported by the current linearizer");
+    const uint32_t image_height = (t.target == 0 || t.target == 3) ? 1u : std::max(1u, t.height);
+    std::vector<LinearLevel> layout;
+    if (t.stride) {
+        if (levels != 1 || format.compressed)
+            fail(texture_context(0, t) + ": pitch-linear mip/compressed upload is unsupported");
+        const uint32_t row_count = (image_height + format.block_height - 1) / format.block_height;
+        const uint64_t tight_row = uint64_t((std::max(1u, t.width) + format.block_width - 1) / format.block_width) *
+                                   format.bytes;
+        if (t.stride < tight_row) fail(texture_context(0, t) + ": pitch-linear stride is shorter than a texture row");
+        const uint64_t source_layer = uint64_t(t.stride) * row_count;
+        const uint64_t required = source_layer * layers;
+        if (required > t.storage_size) fail(texture_context(0, t) + ": pitch-linear data exceeds NVN storage");
+        LevelData level;
+        level.width = std::max(1u, t.width);
+        level.height = std::max(1u, t.height);
+        level.slices = layers;
+        level.row_bytes = uint64_t((level.width + format.block_width - 1) / format.block_width) * format.bytes;
+        level.image_bytes = level.row_bytes * row_count;
+        level.layer_size = level.image_bytes;
+        level.offset = 0;
+        bytes.resize(level.image_bytes * layers);
+        for (uint32_t slice = 0; slice < layers; ++slice)
+            for (uint32_t row = 0; row < row_count; ++row)
+                std::memcpy(bytes.data() + uint64_t(slice) * level.image_bytes + uint64_t(row) * level.row_bytes,
+                            source + uint64_t(slice) * source_layer + uint64_t(row) * t.stride, level.row_bytes);
+        return {level};
+    }
+    layout = deswizzle_texture(source, t.storage_size, std::max(1u, t.width),
+                               image_height, layers, levels, format.block_width, format.block_height,
+                               format.bytes, bytes, t.block_height_gobs);
+    if (layout.empty()) fail(texture_context(0, t) + ": could not untile the NVN mip/array layout");
+    std::vector<LevelData> result;
+    result.reserve(layout.size());
+    for (const LinearLevel& l : layout) {
+        LevelData level;
+        level.offset = l.offset;
+        level.layer_size = l.layer_size;
+        level.row_bytes = uint64_t(l.width_blocks) * format.bytes;
+        level.image_bytes = level.row_bytes * l.height_blocks;
+        level.width = l.width;
+        level.height = l.height;
+        level.slices = layers;
+        result.push_back(level);
+    }
+    return result;
+}
+
+uint32_t host_bytes(uint32_t f) {
+    uint32_t bw = 1, bh = 1, bytes = 0;
+    format_block(f, bw, bh, bytes);
+    if (bw != 1 || bh != 1) fail("Metal texture: decoded host format is still block compressed");
+    return bytes;
+}
+
+void expand_rgb(const uint8_t* src, uint8_t* dst, uint64_t texels, uint32_t format) {
+    uint32_t input = 0, output = 0;
+    switch (format) {
+        case 0x19: case 0x1a: case 0x1b: case 0x1c: input = 3; output = 4; break;
+        case 0x1d: case 0x1e: case 0x1f: case 0x20: case 0x21: input = 6; output = 8; break;
+        case 0x22: case 0x23: case 0x24: input = 12; output = 16; break;
+        default: fail("Metal texture: unexpected RGB-expansion format");
+    }
+    uint8_t one[4] = {};
+    switch (format) {
+        case 0x19: one[0] = 0xff; break;                 // UNORM
+        case 0x1a: one[0] = 0x7f; break;                 // SNORM
+        case 0x1b: case 0x1c: one[0] = 1; break;         // UINT/SINT
+        case 0x1d: { const uint16_t h = 0x3c00; std::memcpy(one, &h, 2); break; }
+        case 0x1e: { const uint16_t v = 0xffff; std::memcpy(one, &v, 2); break; }
+        case 0x1f: { const uint16_t v = 0x7fff; std::memcpy(one, &v, 2); break; }
+        case 0x20: case 0x21: { const uint16_t v = 1; std::memcpy(one, &v, 2); break; }
+        case 0x22: { const float v = 1.f; std::memcpy(one, &v, 4); break; }
+        case 0x23: case 0x24: { const uint32_t v = 1; std::memcpy(one, &v, 4); break; }
+    }
+    for (uint64_t i = 0; i < texels; ++i) {
+        std::memcpy(dst + i * output, src + i * input, input);
+        std::memcpy(dst + i * output + input, one, output - input);
+    }
+}
+
+void widen_r11g11b10(const uint8_t* src, uint8_t* dst, uint64_t texels) {
+    for (uint64_t i = 0; i < texels; ++i) {
+        uint32_t value = 0;
+        std::memcpy(&value, src + i * 4, 4);
+        uint16_t rgba[4] = {uint16_t((value & 0x7ffu) << 4), uint16_t(((value >> 11) & 0x7ffu) << 4),
+                            uint16_t(((value >> 22) & 0x3ffu) << 5), 0x3c00};
+        std::memcpy(dst + i * 8, rgba, sizeof rgba);
+    }
+}
+
+std::vector<LevelData> convert_payload(const Texture& t, const uint8_t* source, const Format& source_format,
+                                       MetalBacking& backing, std::vector<uint8_t>& bytes) {
+    std::vector<LevelData> levels = read_texture_bytes(t, source, source_format, bytes);
+    if (!backing.decoded && !backing.expanded_rgb && t.format != 0x3f) return levels;
+    std::vector<uint8_t> converted;
+    std::vector<LevelData> result;
+    result.reserve(levels.size());
+    uint32_t output_bpp = host_bytes(backing.host_format);
+    for (const LevelData& l : levels) {
+        LevelData dst = l;
+        dst.offset = converted.size();
+        dst.row_bytes = uint64_t(l.width) * output_bpp;
+        dst.image_bytes = dst.row_bytes * l.height;
+        dst.layer_size = dst.image_bytes;
+        uint64_t total = dst.image_bytes * l.slices;
+        if (total > (1ull << 31) || converted.size() > SIZE_MAX - total)
+            fail(texture_context(0, t) + ": converted texture exceeds the safe CPU upload limit");
+        converted.resize(converted.size() + size_t(total));
+        const uint8_t* src = bytes.data() + l.offset;
+        uint8_t* output = converted.data() + dst.offset;
+        if (backing.astc) {
+            if (!astc_decode_image(src, l.width, l.height, l.slices, source_format.block_width,
+                                   source_format.block_height, source_format.srgb, output))
+                fail(texture_context(0, t) + ": ASTC decoder is unavailable");
+        } else if (backing.bc) {
+            bc_decode(t.format, src, l.width, l.height, l.slices, output);
+        } else if (backing.expanded_rgb) {
+            for (uint32_t slice = 0; slice < l.slices; ++slice)
+                expand_rgb(src + uint64_t(slice) * l.layer_size, output + uint64_t(slice) * dst.image_bytes,
+                           uint64_t(l.width) * l.height, t.format);
+        } else if (t.format == 0x3f) {
+            widen_r11g11b10(src, output, uint64_t(l.width) * l.height * l.slices);
+        }
+        result.push_back(dst);
+    }
+    bytes.swap(converted);
+    return result;
+}
+
+uint32_t texture_slices(const Texture& t) { return t.target == 2 ? std::max(1u, t.depth) : total_layers(t); }
+
+uint8_t available_aspects(const Texture& t) {
+    if (t.format == 0x31) return TextureStencil;
+    if (t.format >= 0x32 && t.format <= 0x34) return TextureDepth;
+    if (t.format == 0x35 || t.format == 0x36) return TextureDepth | TextureStencil;
+    return TextureColor;
+}
+
+uint32_t slices_at_level(const Texture& t, uint32_t level) {
+    return t.target == 2 ? std::max(1u, t.depth >> level) : texture_slices(t);
+}
+
+void ensure_subresource_state(const Texture& t, MetalBacking& backing) {
+    const uint64_t count = uint64_t(mip_count(t)) * texture_slices(t);
+    if (count > SIZE_MAX) fail(texture_context(0, t) + ": subresource state exceeds addressable memory");
+    if (backing.initialized_subresources.size() != size_t(count))
+        backing.initialized_subresources.resize(size_t(count), 0);
+}
+
+size_t subresource_index(const Texture& t, uint32_t level, uint32_t slice) {
+    return size_t(uint64_t(level) * texture_slices(t) + slice);
+}
+
+void mark_subresource(Texture& t, MetalBacking& backing, uint32_t level, uint32_t slice, uint8_t aspects) {
+    ensure_subresource_state(t, backing);
+    if (level >= mip_count(t) || slice >= slices_at_level(t, level))
+        fail(texture_context(0, t) + ": initialized subresource is outside the texture");
+    backing.initialized_subresources[subresource_index(t, level, slice)] |= aspects & available_aspects(t);
+}
+
+void mark_all_subresources(const Texture& t, MetalBacking& backing) {
+    ensure_subresource_state(t, backing);
+    const uint8_t aspects = available_aspects(t);
+    for (uint32_t level = 0; level < mip_count(t); ++level)
+        for (uint32_t slice = 0; slice < slices_at_level(t, level); ++slice)
+            backing.initialized_subresources[subresource_index(t, level, slice)] = aspects;
+    backing.initialized = true;
+}
+
+MTLTextureDescriptor* descriptor(const Texture& t, MTLPixelFormat pixel, MTLTextureUsage usage) {
+    MTLTextureDescriptor* d = [MTLTextureDescriptor new];
+    d.textureType = texture_type(t);
+    d.pixelFormat = pixel;
+    d.width = std::max(1u, t.width);
+    d.height = (t.target == 0 || t.target == 3) ? 1 : std::max(1u, t.height);
+    d.depth = t.target == 2 ? std::max(1u, t.depth) : 1;
+    d.mipmapLevelCount = (t.target == 5 || t.target == 6) ? 1 : mip_count(t);
+    d.sampleCount = std::max(1u, t.samples);
+    d.arrayLength = t.target == 8 ? 1 : t.target == 9 ? std::max(1u, texture_slices(t) / 6) :
+                       (t.target == 3 || t.target == 4 || t.target == 6) ? texture_slices(t) : 1;
+    d.storageMode = MTLStorageModePrivate;
+    d.usage = usage;
+    return d;
+}
+
+bool compatible_view(uint32_t base, uint32_t view) {
+    if (base == view || !view) return true;
+    if (is_depth_stencil_format(base) || is_depth_stencil_format(view)) return false;
+    uint32_t bw = 1, bh = 1, bb = 0, vw = 1, vh = 1, vb = 0;
+    format_block(base, bw, bh, bb);
+    format_block(view, vw, vh, vb);
+    return bw == vw && bh == vh && bb == vb;
+}
+
+id<MTLTexture> make_texture(const Texture& t, MetalBacking& backing, MTLTextureUsage usage) {
+    MTLPixelFormat pixel = format_for(backing.host_format).pixel;
+    if (pixel == MTLPixelFormatInvalid) fail(texture_context(0, t) + ": Metal has no compatible pixel format");
+    MTLTextureDescriptor* d = descriptor(t, pixel, usage);
+    id<MTLTexture> result = [device() newTextureWithDescriptor:d];
+    if (!result && backing.astc) {
+        backing.decoded = backing.astc = true;
+        backing.host_format = host_format(t.format, false, true);
+        d = descriptor(t, format_for(backing.host_format).pixel, usage);
+        result = [device() newTextureWithDescriptor:d];
+    } else if (!result && backing.bc && t.format != 0x4f && t.format != 0x50) {
+        backing.decoded = backing.bc = true;
+        backing.host_format = host_format(t.format, true, false);
+        d = descriptor(t, format_for(backing.host_format).pixel, usage);
+        result = [device() newTextureWithDescriptor:d];
+    }
+    if (!result) fail(texture_context(0, t) + ": Metal rejected texture format, shape, sample count or usage");
+    return result;
+}
+
+void encode_buffer_to_texture(id<MTLBuffer> source, id<MTLTexture> dest, NSUInteger offset, uint32_t width,
+                              uint32_t height, uint32_t depth, uint32_t slice, uint32_t level,
+                              uint64_t row_bytes, uint32_t block_h) {
+    uint64_t rows = (uint64_t(height) + block_h - 1) / block_h;
+    uint64_t row_pitch = align_up(row_bytes, 256);
+    uint64_t image_pitch = align_up(row_pitch * rows, 256);
+    if (offset > source.length || image_pitch * depth > source.length - offset)
+        fail("Metal texture upload: staging buffer range is too small");
+    MTLSize size = MTLSizeMake(width, height, depth);
+    id<MTLBlitCommandEncoder> blit = [command_buffer() blitCommandEncoder];
+    if (!blit) fail("Metal texture upload: could not create a blit encoder");
+    [blit copyFromBuffer:source
+            sourceOffset:offset
+       sourceBytesPerRow:row_pitch
+     sourceBytesPerImage:image_pitch
+              sourceSize:size
+               toTexture:dest
+        destinationSlice:slice
+        destinationLevel:level
+       destinationOrigin:MTLOriginMake(0, 0, 0)];
+    [blit endEncoding];
+}
+
+void upload_payload(const Texture& t, MetalBacking& backing, id<MTLTexture> dest, const std::vector<uint8_t>& bytes,
+                    const std::vector<LevelData>& levels, uint32_t block_w, uint32_t block_h, uint32_t bytes_per_block) {
+    if (t.samples > 1) fail(texture_context(0, t) + ": CPU upload to multisample texture is unsupported");
+    const uint32_t slices = texture_slices(t);
+    for (uint32_t level = 0; level < levels.size(); ++level) {
+        const LevelData& l = levels[level];
+        uint64_t row_bytes = uint64_t((l.width + block_w - 1) / block_w) * bytes_per_block;
+        uint64_t rows = (uint64_t(l.height) + block_h - 1) / block_h;
+        uint64_t pitch = align_up(row_bytes, 256), image = align_up(pitch * rows, 256);
+        uint32_t depth = t.target == 2 ? l.slices : 1;
+        uint32_t slice_count = t.target == 2 ? 1 : slices;
+        uint64_t padded_size = image * depth * slice_count;
+        if (padded_size > (1ull << 31) || padded_size > SIZE_MAX) fail(texture_context(0, t) + ": upload staging is too large");
+        std::vector<uint8_t> padded(size_t(padded_size), 0);
+        for (uint32_t s = 0; s < slice_count; ++s) {
+            for (uint32_t z = 0; z < depth; ++z) {
+                const uint8_t* src = bytes.data() + l.offset + (uint64_t(s * depth + z) * l.layer_size);
+                uint8_t* dst = padded.data() + uint64_t(s * depth + z) * image;
+                for (uint64_t row = 0; row < rows; ++row)
+                    std::memcpy(dst + row * pitch, src + row * l.row_bytes, row_bytes);
+            }
+            id<MTLBuffer> staging = [device() newBufferWithBytes:padded.data() + uint64_t(s * depth) * image
+                                                           length:image * depth
+                                                          options:MTLResourceStorageModeShared];
+            if (!staging) fail(texture_context(0, t) + ": Metal upload staging allocation failed");
+            end_encoding();
+            uint32_t slice = t.target == 2 ? 0 : s;
+            encode_buffer_to_texture(staging, dest, 0, l.width, l.height, depth, slice, level, row_bytes, block_h);
+        }
+    }
+    mark_all_subresources(t, backing);
+}
+
+// The existing sampled-image contract uses a cleared cube when a shader's cube declaration receives a 2D
+// texture. Metal cannot create that view. Keep this known case separate from invalid ranges/storage writes.
+id<MTLTexture> incompatible_cube_sample(const ImageShape& shape) {
+    if (shape.dim != 3 || shape.ms || shape.sampled != 1 ||
+        (shape.component != ScalarType::Float && shape.component != ScalarType::Sint &&
+         shape.component != ScalarType::Uint) || (shape.depth && shape.component != ScalarType::Float))
+        fail("Metal texture: unsupported incompatible sampled cube declaration");
+    const auto key = std::make_tuple(shape.arrayed, shape.depth, uint32_t(shape.component));
+    static std::map<decltype(key), __strong id<MTLTexture>> cache;
+    if (auto it = cache.find(key); it != cache.end()) return it->second;
+    MTLTextureDescriptor* d = [MTLTextureDescriptor new];
+    d.textureType = shape.arrayed ? MTLTextureTypeCubeArray : MTLTextureTypeCube;
+    d.pixelFormat = shape.depth ? MTLPixelFormatDepth32Float
+                   : shape.component == ScalarType::Sint ? MTLPixelFormatRGBA8Sint
+                   : shape.component == ScalarType::Uint ? MTLPixelFormatRGBA8Uint
+                                                         : MTLPixelFormatRGBA8Unorm;
+    d.width = d.height = d.depth = d.arrayLength = d.mipmapLevelCount = d.sampleCount = 1;
+    d.storageMode = MTLStorageModePrivate;
+    d.usage = MTLTextureUsageShaderRead;
+    id<MTLTexture> result = [device() newTextureWithDescriptor:d];
+    if (!result) fail("Metal texture: failed to allocate incompatible sampled cube replacement");
+    std::array<uint8_t, 256> bytes{};
+    if (shape.depth) {
+        const float depth = 1.f;
+        std::memcpy(bytes.data(), &depth, sizeof depth);
+    }
+    id<MTLBuffer> staging = [device() newBufferWithBytes:bytes.data() length:bytes.size()
+                                             options:MTLResourceStorageModeShared];
+    if (!staging) fail("Metal texture: failed to allocate sampled cube initialization buffer");
+    end_encoding();
+    for (uint32_t face = 0; face < 6; ++face)
+        encode_buffer_to_texture(staging, result, 0, 1, 1, 1, face, 0, 4, 1);
+    cache.emplace(key, result);
+    return result;
+}
+
+void upload_pitch_dirty(Texture& t, MetalBacking& backing, const uint8_t* source, uint64_t dirty_lo,
+                       uint64_t dirty_hi) {
+    if (!t.stride || t.target != 1 || texture_slices(t) != 1 || mip_count(t) != 1 || t.samples > 1)
+        fail("Metal texture: CPU writes after rendering require a single-level pitch-linear 2D texture");
+    Format input = format_for(t.format);
+    if (input.compressed) fail("Metal texture: CPU writes after rendering to compressed textures are unsupported");
+    const uint32_t rows = std::max(1u, t.height);
+    uint64_t y0 = 0, y1 = rows;
+    if (dirty_hi != UINT64_MAX && dirty_hi > dirty_lo) {
+        y0 = std::min<uint64_t>(rows, dirty_lo / t.stride);
+        y1 = std::min<uint64_t>(rows, 1 + (dirty_hi - 1) / t.stride);
+    }
+    if (y1 <= y0) return;
+    std::vector<uint8_t> payload;
+    auto levels = convert_payload(t, source, input, backing, payload);
+    if (levels.size() != 1) fail("Metal texture: dirty pitch upload has an unexpected mip layout");
+    const LevelData& level = levels.front();
+    uint64_t row_pitch = align_up(level.row_bytes, 256);
+    if (row_pitch > UINT64_MAX / (y1 - y0)) fail("Metal texture: dirty pitch upload size overflow");
+    uint64_t image_pitch = align_up(row_pitch * (y1 - y0), 256);
+    if (image_pitch > SIZE_MAX || image_pitch > (1ull << 31))
+        fail("Metal texture: dirty pitch upload exceeds the safe staging limit");
+    std::vector<uint8_t> staging_bytes(size_t(image_pitch), 0);
+    for (uint64_t row = y0; row < y1; ++row)
+        std::memcpy(staging_bytes.data() + (row - y0) * row_pitch,
+                    payload.data() + level.offset + row * level.row_bytes, level.row_bytes);
+    id<MTLBuffer> staging = [device() newBufferWithBytes:staging_bytes.data() length:staging_bytes.size()
+                                                 options:MTLResourceStorageModeShared];
+    if (!staging) fail("Metal texture: dirty upload staging allocation failed");
+    end_encoding();
+    id<MTLBlitCommandEncoder> blit = [command_buffer() blitCommandEncoder];
+    if (!blit) fail("Metal texture: dirty upload blit encoder creation failed");
+    [blit copyFromBuffer:staging sourceOffset:0 sourceBytesPerRow:row_pitch sourceBytesPerImage:image_pitch
+               sourceSize:MTLSizeMake(t.width, uint32_t(y1 - y0), 1) toTexture:backing.object destinationSlice:0
+         destinationLevel:0 destinationOrigin:MTLOriginMake(0, NSUInteger(y0), 0)];
+    [blit endEncoding];
+    mark_subresource(t, backing, 0, 0, available_aspects(t));
+    backing.initialized = true;
+}
+
+void zero_texture(const Texture& t, MetalBacking& backing) {
+    if (is_depth_stencil_format(t.format) && t.format != 0x32 && t.format != 0x33 && t.format != 0x34)
+        fail(texture_context(0, t) + ": clearing this depth/stencil format before a render is unsupported");
+    if (t.samples > 1) fail(texture_context(0, t) + ": zero initialization of multisample textures is unsupported");
+    Format f = format_for(backing.host_format);
+    if (f.pixel == MTLPixelFormatInvalid) fail(texture_context(0, t) + ": zero format is unsupported");
+    std::vector<LevelData> levels;
+    std::vector<uint8_t> bytes;
+    uint32_t layers = texture_slices(t), count = mip_count(t);
+    uint64_t at = 0;
+    for (uint32_t level = 0; level < count; ++level) {
+        LevelData l;
+        l.width = std::max(1u, t.width >> level);
+        l.height = (t.target == 0 || t.target == 3) ? 1u : std::max(1u, t.height >> level);
+        l.slices = t.target == 2 ? std::max(1u, t.depth >> level) : layers;
+        l.row_bytes = uint64_t((l.width + f.block_width - 1) / f.block_width) * f.bytes;
+        uint64_t rows = (uint64_t(l.height) + f.block_height - 1) / f.block_height;
+        l.image_bytes = l.row_bytes * rows;
+        l.layer_size = l.image_bytes;
+        l.offset = at;
+        at += l.image_bytes * l.slices;
+        levels.push_back(l);
+    }
+    if (at > SIZE_MAX || at > (1ull << 31)) fail(texture_context(0, t) + ": zero initialization exceeds safe limit");
+    bytes.assign(size_t(at), 0);
+    if (t.format == 0x32) {
+        for (size_t i = 0; i < bytes.size(); i += 2) bytes[i] = bytes[i + 1] = 0xff;
+    } else if (t.format == 0x33 || t.format == 0x34) {
+        const float one = 1.f;
+        for (size_t i = 0; i + sizeof one <= bytes.size(); i += sizeof one) std::memcpy(bytes.data() + i, &one, sizeof one);
+    } else if (t.format == 0x3f) {
+        const uint16_t one = 0x3c00;
+        for (size_t i = 6; i < bytes.size(); i += 8) std::memcpy(bytes.data() + i, &one, sizeof one);
+    }
+    upload_payload(t, backing, backing.object, bytes, levels, f.block_width, f.block_height, f.bytes);
+}
+
+uint32_t output_bytes(const MetalBacking& backing) { return host_bytes(backing.host_format); }
+
+void apply_writes(Texture& t, MetalBacking& backing) {
+    if (!t.has_writes.load(std::memory_order_acquire)) return;
+    std::vector<Texture::TexelWrite> writes;
+    {
+        std::lock_guard lock(objects_lock());
+        writes.swap(t.writes);
+        t.has_writes.store(false, std::memory_order_release);
+    }
+    if (writes.empty()) return;
+    Format input = format_for(t.format);
+    if (input.pixel == MTLPixelFormatInvalid) fail("Metal texture writes: unknown NVN format");
+    for (const auto& w : writes) {
+        if (w.level >= mip_count(t) || !w.w || !w.h || !w.d)
+            fail("Metal texture writes: invalid region or mip level");
+        uint32_t bw = input.block_width, bh = input.block_height, input_bytes = input.bytes;
+        uint32_t level_width = std::max(1u, t.width >> w.level);
+        uint32_t level_height = (t.target == 0 || t.target == 3) ? 1u : std::max(1u, t.height >> w.level);
+        uint32_t level_slices = t.target == 2 ? std::max(1u, t.depth >> w.level) : texture_slices(t);
+        if (uint64_t(w.x) + w.w > level_width || uint64_t(w.y) + w.h > level_height ||
+            uint64_t(w.z) + w.d > level_slices)
+            fail("Metal texture writes: region exceeds the selected mip or array");
+        if ((w.x % bw) || (w.y % bh) || ((w.w % bw) && uint64_t(w.x) + w.w != level_width) ||
+            ((w.h % bh) && uint64_t(w.y) + w.h != level_height))
+            fail("Metal texture writes: compressed region is not block aligned");
+        uint32_t host = output_bytes(backing);
+        std::vector<uint8_t> pixels;
+        const uint8_t* src = w.data.data();
+        uint64_t row_bytes = uint64_t((w.w + bw - 1) / bw) * input_bytes;
+        uint64_t row_count = (uint64_t(w.h) + bh - 1) / bh;
+        uint64_t slice_bytes = row_bytes * row_count;
+        if (w.data.size() < slice_bytes * w.d) fail("Metal texture writes: region bytes are truncated");
+        if (backing.decoded) {
+            pixels.resize(uint64_t(w.w) * w.h * w.d * host);
+            if (backing.astc) {
+                if (!astc_decode_image(src, w.w, w.h, w.d, bw, bh, input.srgb, pixels.data()))
+                    fail("Metal texture writes: ASTC decoder rejected a block");
+            } else if (backing.bc) {
+                bc_decode(t.format, src, w.w, w.h, w.d, pixels.data());
+            } else {
+                fail("Metal texture writes: unknown decoded format");
+            }
+            src = pixels.data();
+            row_bytes = uint64_t(w.w) * host;
+            row_count = w.h;
+            slice_bytes = row_bytes * row_count;
+            bw = bh = 1;
+        } else if (backing.expanded_rgb) {
+            pixels.resize(uint64_t(w.w) * w.h * host * w.d);
+            for (uint32_t z = 0; z < w.d; ++z)
+                expand_rgb(src + uint64_t(z) * slice_bytes, pixels.data() + uint64_t(z) * w.w * w.h * host,
+                           uint64_t(w.w) * w.h, t.format);
+            src = pixels.data();
+            row_bytes = uint64_t(w.w) * host;
+            row_count = w.h;
+            slice_bytes = row_bytes * row_count;
+            bw = bh = 1;
+        } else if (t.format == 0x3f) {
+            pixels.resize(uint64_t(w.w) * w.h * w.d * host);
+            widen_r11g11b10(src, pixels.data(), uint64_t(w.w) * w.h * w.d);
+            src = pixels.data();
+            row_bytes = uint64_t(w.w) * host;
+            row_count = w.h;
+            slice_bytes = row_bytes * row_count;
+            bw = bh = 1;
+        }
+        uint64_t row_pitch = align_up(row_bytes, 256), image_pitch = align_up(row_pitch * row_count, 256);
+        std::vector<uint8_t> staging_bytes(size_t(image_pitch * w.d), 0);
+        for (uint32_t z = 0; z < w.d; ++z)
+            for (uint64_t row = 0; row < row_count; ++row)
+                std::memcpy(staging_bytes.data() + uint64_t(z) * image_pitch + row * row_pitch,
+                            src + uint64_t(z) * slice_bytes + row * row_bytes, row_bytes);
+        id<MTLBuffer> staging = [device() newBufferWithBytes:staging_bytes.data() length:staging_bytes.size()
+                                                     options:MTLResourceStorageModeShared];
+        if (!staging) fail("Metal texture writes: staging allocation failed");
+        end_encoding();
+        id<MTLBlitCommandEncoder> blit = [command_buffer() blitCommandEncoder];
+        if (!blit) fail("Metal texture writes: could not create a blit encoder");
+        bool is_3d = t.target == 2;
+        if (is_3d) {
+            [blit copyFromBuffer:staging sourceOffset:0 sourceBytesPerRow:row_pitch sourceBytesPerImage:image_pitch
+                       sourceSize:MTLSizeMake(w.w, w.h, w.d) toTexture:backing.object destinationSlice:0
+                 destinationLevel:w.level destinationOrigin:MTLOriginMake(w.x, w.y, w.z)];
+        } else {
+            for (uint32_t slice = 0; slice < w.d; ++slice)
+                [blit copyFromBuffer:staging sourceOffset:NSUInteger(uint64_t(slice) * image_pitch)
+                   sourceBytesPerRow:row_pitch sourceBytesPerImage:image_pitch sourceSize:MTLSizeMake(w.w, w.h, 1)
+                            toTexture:backing.object destinationSlice:w.z + slice destinationLevel:w.level
+                     destinationOrigin:MTLOriginMake(w.x, w.y, 0)];
+        }
+        [blit endEncoding];
+        for (uint32_t slice = 0; slice < w.d; ++slice)
+            mark_subresource(t, backing, w.level, w.z + slice, available_aspects(t));
+    }
+    backing.initialized = true;
+}
+
+MTLCompareFunction compare_function(uint32_t value) {
+    switch (value) {
+        case 1: return MTLCompareFunctionNever;
+        case 2: return MTLCompareFunctionLess;
+        case 3: return MTLCompareFunctionEqual;
+        case 4: return MTLCompareFunctionLessEqual;
+        case 5: return MTLCompareFunctionGreater;
+        case 6: return MTLCompareFunctionNotEqual;
+        case 7: return MTLCompareFunctionGreaterEqual;
+        case 8: return MTLCompareFunctionAlways;
+        default: fail("Metal sampler: invalid NVN compare function");
+    }
+}
+
+MTLSamplerAddressMode address_mode(uint32_t value) {
+    switch (value) {
+        case 0: case 7: return MTLSamplerAddressModeClampToEdge;
+        case 1: return MTLSamplerAddressModeRepeat;
+        case 2: case 3: return MTLSamplerAddressModeMirrorClampToEdge;
+        case 4: fail("Metal sampler: mirror-clamp-to-border has no exact Metal address mode");
+        case 5: return MTLSamplerAddressModeClampToBorderColor;
+        case 6: return MTLSamplerAddressModeMirrorRepeat;
+        default: fail("Metal sampler: unknown NVN wrap mode");
+    }
+}
