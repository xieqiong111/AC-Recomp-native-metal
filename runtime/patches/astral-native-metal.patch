+}  // namespace
+
+const uint8_t* mapped_buffer_bytes(uint64_t address, uint64_t length) {
+    if (!address || !length || length > NSUIntegerMax) fail("Metal buffer: empty or oversized NVN range");
+    const HostRange host = host_range(address, length);
+    if (host.segment_size > UINTPTR_MAX - host.segment_begin || host.address < host.segment_begin ||
+        host.address > host.segment_begin + host.segment_size ||
+        length > host.segment_begin + host.segment_size - host.address)
+        fail("Metal buffer: CPU snapshot would cross an NVN pool/mapping boundary");
+    return reinterpret_cast<const uint8_t*>(host.address);
+}
+
+Buffer buffer_for_gpu(uint64_t address, uint64_t length, bool writable) {
+    (void)writable;  // Shared aliases are coherent in both directions; they are never replaced with stale CPU copies.
+    if (!address || !length || length > NSUIntegerMax) fail("Metal buffer: empty or oversized NVN range");
+    HostRange host = host_range(address, length);
+    const long page_raw = sysconf(_SC_PAGESIZE);
+    if (page_raw <= 0) fail("Metal buffer: could not determine host page size");
+    const uintptr_t page = uintptr_t(page_raw);
+    if ((page & (page - 1)) != 0) fail("Metal buffer: host page size is not a power of two");
+    uintptr_t base = host.address & ~(page - 1);
+    uint64_t prefix = host.address - base;
+    if (length > UINT64_MAX - prefix) fail("Metal buffer: page-aligned alias size overflow");
+    uint64_t alias_size = align_up(prefix + length, page);
+    if (host.segment_size > UINTPTR_MAX - host.segment_begin)
+        fail("Metal buffer: host pool segment address overflow");
+    uintptr_t segment_end = host.segment_begin + host.segment_size;
+    if (base < host.segment_begin || base > segment_end || alias_size > segment_end - base)
+        fail("Metal buffer: page-aligned alias would cross an NVN pool/mapping boundary");
+    if (alias_size > NSUIntegerMax) fail("Metal buffer: page-aligned alias exceeds Metal's addressable range");
+
+    std::lock_guard lock(g_alias_mutex);
+    AliasKey key{base, NSUInteger(alias_size)};
+    auto& entry = g_aliases[key];
+    if (!entry.object) {
+        entry.object = [device() newBufferWithBytesNoCopy:reinterpret_cast<void*>(base)
+                                                  length:NSUInteger(alias_size)
+                                                 options:MTLResourceStorageModeShared
+                                             deallocator:nil];
+        if (!entry.object) fail("Metal buffer: no-copy alias rejected (range is not page-backed/shared)" );
+    }
+    note_alias_read(host.address, host.address + length);
+    return {entry.object, NSUInteger(prefix)};
+}
+
+bool subresource_initialized(uint64_t guest, const ViewInfo* view, uint8_t aspects) {
+    Texture* t = get<Texture>(guest);
+    if (!t) return false;
+    auto image = texture_image(*t);
+    if (!image) return false;
+    auto backing = std::dynamic_pointer_cast<MetalBacking>(image);
+    if (!backing || !backing->object) return false;
+    const uint8_t available = available_aspects(*t);
+    if (!aspects || (aspects & available) != aspects) return false;
+    ensure_subresource_state(*t, *backing);
+    uint32_t base_level = view ? view->base_level : 0;
+    uint32_t level_count = view && view->levels ? view->levels : mip_count(*t) - std::min(base_level, mip_count(*t));
+    uint32_t base_slice = view ? view->min_layer : 0;
+    uint32_t slice_count = view && view->layers ? view->layers : 0;
+    if (base_level >= mip_count(*t) || !level_count || level_count > mip_count(*t) - base_level ||
+        base_slice >= texture_slices(*t) || (slice_count && slice_count > texture_slices(*t) - base_slice))
+        return false;
+    for (uint32_t level = base_level; level < base_level + level_count; ++level) {
+        uint32_t count = slice_count ? slice_count : slices_at_level(*t, level) - base_slice;
+        if (!count || base_slice + count > slices_at_level(*t, level)) return false;
+        for (uint32_t slice = base_slice; slice < base_slice + count; ++slice)
+            if ((backing->initialized_subresources[subresource_index(*t, level, slice)] & aspects) != aspects)
+                return false;
+    }
+    return true;
+}
+
+void mark_rendered(uint64_t guest, const ViewInfo* view, uint8_t aspects) {
+    Texture* t = get<Texture>(guest);
+    if (!t) fail("Metal texture: mark_rendered called before texture creation");
+    auto image = texture_image(*t);
+    if (!image) fail("Metal texture: mark_rendered called before texture creation");
+    auto backing = std::dynamic_pointer_cast<MetalBacking>(image);
+    if (!backing || !backing->object) fail("Metal texture: render target has no Metal backing");
+    const uint8_t selected = aspects & available_aspects(*t);
+    ensure_subresource_state(*t, *backing);
+    uint32_t base_level = view ? view->base_level : 0;
+    uint32_t level_count = view && view->levels ? view->levels : mip_count(*t) - std::min(base_level, mip_count(*t));
+    uint32_t base_slice = view ? view->min_layer : 0;
+    uint32_t slice_count = view && view->layers ? view->layers : 0;
+    if (base_level >= mip_count(*t) || !level_count || level_count > mip_count(*t) - base_level ||
+        base_slice >= texture_slices(*t) || (slice_count && slice_count > texture_slices(*t) - base_slice))
+        fail(texture_context(guest, *t) + ": rendered view is outside the texture");
+    for (uint32_t level = base_level; level < base_level + level_count; ++level) {
+        uint32_t count = slice_count ? slice_count : slices_at_level(*t, level) - base_slice;
+        if (!count || base_slice + count > slices_at_level(*t, level))
+            fail(texture_context(guest, *t) + ": rendered view exceeds a mip's slices");
+        for (uint32_t slice = base_slice; slice < base_slice + count; ++slice)
+            mark_subresource(*t, *backing, level, slice, selected);
+    }
+    backing->rendered = backing->initialized = true;
+}
+
+id<MTLTexture> texture(uint64_t guest, const ViewInfo* view, const ImageShape* shape, bool attachment, bool storage) {
+    if (!guest) fail("Metal texture: null NVN texture handle");
+    Texture* t = get<Texture>(guest);
+    if (!t) fail("Metal texture: NVN texture handle is unresolved");
+    if (!device() || !command_buffer()) fail("Metal texture: renderer is not initialized");
+    if (!t->width || !t->height || !t->levels) fail(texture_context(guest, *t) + ": invalid dimensions or mip count");
+    if (t->target > 10) fail(texture_context(guest, *t) + ": unknown NVN texture target");
+    if (view && ((view->base_level >= mip_count(*t)) ||
+                 (view->min_layer >= texture_slices(*t))))
+        fail(texture_context(guest, *t) + ": texture view starts outside its backing image");
+    // Validate the actual NVN view before considering the known sampled-dimension compatibility path.
+    if (view && ((view->levels && view->levels > mip_count(*t) - view->base_level) ||
+                 (view->layers && view->layers > texture_slices(*t) - view->min_layer)))
+        fail(texture_context(guest, *t) + ": NVN texture view count exceeds its backing image");
+    if (view && view->format && !compatible_view(t->format, view->format))
+        fail(texture_context(guest, *t) + ": incompatible NVN view format");
+    if (t->target == 10) {
+        if (attachment || storage) fail(texture_context(guest, *t) + ": buffer textures cannot be attachments/storage images");
+        if (view && (view->base_level || (view->levels && view->levels != 1) || view->min_layer ||
+                     (view->layers && view->layers != 1) || (view->format && view->format != t->format)))
+            fail(texture_context(guest, *t) + ": buffer texture views cannot change format or subresources");
+        if (shape && shape->dim != 5) fail(texture_context(guest, *t) + ": shader expects a non-buffer texture view");
+        MTLTextureSwizzleChannels sw = view_swizzle(*t, view);
+        if (sw.red != MTLTextureSwizzleRed || sw.green != MTLTextureSwizzleGreen ||
+            sw.blue != MTLTextureSwizzleBlue || sw.alpha != MTLTextureSwizzleAlpha)
+            fail(texture_context(guest, *t) + ": buffer texture swizzles are unsupported");
+    }
+
+    auto image = texture_image(*t);
+    auto backing = std::dynamic_pointer_cast<MetalBacking>(image);
+    bool mismatch = backing && (backing->source_gpu != t->gpu || backing->source_memory != t->memory ||
+                                backing->source_size != t->storage_size || backing->format != t->format ||
+                                backing->width != t->width || backing->height != t->height ||
+                                backing->depth != t->depth || backing->levels != mip_count(*t) ||
+                                backing->samples != t->samples || backing->target != t->target ||
+                                backing->stride != t->stride || backing->block_height_gobs != t->block_height_gobs);
+    if (image && !backing && !mismatch)
+        fail(texture_context(guest, *t) + ": backing belongs to a different graphics backend");
+    if (mismatch) backing.reset();
+    if (!backing) {
+        Format input = format_for(t->format);
+        if (input.pixel == MTLPixelFormatInvalid)
+            fail(texture_context(guest, *t) + ": unknown or unsupported NVN texture format");
+        backing = std::make_shared<MetalBacking>();
+        backing->source_gpu = t->gpu;
+        backing->source_memory = t->memory;
+        backing->source_size = t->storage_size;
+        backing->format = t->format;
+        backing->width = t->width;
+        backing->height = t->height;
+        backing->depth = t->depth;
+        backing->levels = mip_count(*t);
+        backing->samples = t->samples;
+        backing->target = t->target;
+        backing->stride = t->stride;
+        backing->block_height_gobs = t->block_height_gobs;
+        backing->expanded_rgb = input.rgb;
+        backing->bc = input.bc;
+        backing->astc = input.astc;
+        // Apple GPUs need not expose BC formats. BC1 RGB has no equivalent Metal pixel format (Metal's BC1 includes
+        // alpha), so decode that NVN variant to preserve its forced-opaque semantics.
+        bool force_bc_decode = is_bc_rgb(t->format);
+        backing->decoded = force_bc_decode;
+        backing->host_format = host_format(t->format, force_bc_decode, false);
+        if (t->format == 0x3f) backing->host_format = 0x29;
+        if (t->target == 10) {
+            if (input.compressed || input.rgb || !input.bytes || input.pixel == MTLPixelFormatInvalid)
+                fail(texture_context(guest, *t) + ": unsupported buffer-texture format");
+            uint64_t row_bytes = uint64_t(t->width) * input.bytes;
+            if (!t->width || row_bytes > t->storage_size || !t->gpu)
+                fail(texture_context(guest, *t) + ": invalid buffer-texture range");
+            NSUInteger alignment = [device() minimumTextureBufferAlignmentForPixelFormat:input.pixel];
+            if (!alignment) fail(texture_context(guest, *t) + ": Metal reports no valid buffer-texture alignment");
+            uint64_t row_pitch = align_up(row_bytes, alignment);
+            Buffer raw = buffer_for_gpu(t->gpu, t->storage_size, false);
+            if (raw.offset % alignment || row_pitch > t->storage_size || raw.offset > raw.object.length ||
+                row_pitch > raw.object.length - raw.offset)
+                fail(texture_context(guest, *t) + ": buffer-texture range exceeds its Metal alias");
+            MTLTextureDescriptor* d = [MTLTextureDescriptor new];
+            d.textureType = MTLTextureTypeTextureBuffer;
+            d.pixelFormat = input.pixel;
+            d.width = t->width;
+            d.height = d.depth = 1;
+            d.mipmapLevelCount = 1;
+            d.usage = MTLTextureUsageShaderRead;
+            backing->buffer = raw.object;
+            backing->object = [raw.object newTextureWithDescriptor:d offset:raw.offset bytesPerRow:row_pitch];
+            if (!backing->object) fail(texture_context(guest, *t) + ": Metal rejected buffer texture view");
+            backing->usage = MTLTextureUsageShaderRead;
+            backing->initialized = true;
+            set_texture_image(*t, backing);
+            return backing->object;
+        }
+        backing->usage = MTLTextureUsageShaderRead;
+        if (attachment) backing->usage |= MTLTextureUsageRenderTarget;
+        if (storage) backing->usage |= MTLTextureUsageShaderWrite;
+        if (!input.compressed && backing->host_format == rgb_expansion_format(t->format) &&
+            format_for(backing->host_format).pixel != input.pixel)
+            backing->usage |= MTLTextureUsagePixelFormatView;
+        backing->object = make_texture(*t, *backing, backing->usage);
+        set_texture_image(*t, backing);
+    }
+
+    MTLTextureUsage required = MTLTextureUsageShaderRead;
+    if (attachment) required |= MTLTextureUsageRenderTarget;
+    if (storage) required |= MTLTextureUsageShaderWrite;
+    if (view && view->format && view->format != t->format) required |= MTLTextureUsagePixelFormatView;
+    if ((backing->usage & required) != required) {
+        MTLTextureUsage upgraded = backing->usage | required;
+        id<MTLTexture> replacement = make_texture(*t, *backing, upgraded);
+        if (backing->initialized) {
+            end_encoding();
+            id<MTLBlitCommandEncoder> blit = [command_buffer() blitCommandEncoder];
+            if (!blit) fail(texture_context(guest, *t) + ": cannot preserve texture during usage upgrade");
+            uint32_t count = mip_count(*t), slices = texture_slices(*t);
+            for (uint32_t level = 0; level < count; ++level) {
+                MTLSize size = MTLSizeMake(std::max(1u, t->width >> level), std::max(1u, t->height >> level),
+                                           t->target == 2 ? std::max(1u, t->depth >> level) : 1);
+                if (t->target == 2) {
+                    [blit copyFromTexture:backing->object sourceSlice:0 sourceLevel:level sourceOrigin:MTLOriginMake(0, 0, 0)
+                               sourceSize:size toTexture:replacement destinationSlice:0 destinationLevel:level
+                         destinationOrigin:MTLOriginMake(0, 0, 0)];
+                } else {
+                    for (uint32_t slice = 0; slice < slices; ++slice)
+                        [blit copyFromTexture:backing->object sourceSlice:slice sourceLevel:level sourceOrigin:MTLOriginMake(0, 0, 0)
+                                   sourceSize:size toTexture:replacement destinationSlice:slice destinationLevel:level
+                             destinationOrigin:MTLOriginMake(0, 0, 0)];
+                }
+            }
+            [blit endEncoding];
+        }
+        backing->object = replacement;
+        backing->usage = upgraded;
+        backing->views.clear();
+    }
+
+    if (t->target == 10) {
+        // Buffer textures are constructed from a native no-copy pool alias above.
+        if (!backing->object) fail(texture_context(guest, *t) + ": buffer texture has no Metal image");
+        return backing->object;
+    } else if (!backing->initialized && t->samples <= 1) {
+        if ((t->memory || t->gpu) && t->storage_size && !(t->flags & 0x8) && !is_depth_stencil_format(t->format)) {
+            uint64_t source_gpu = t->gpu;
+            uint64_t size = t->storage_size;
+            const uint8_t* source = reinterpret_cast<const uint8_t*>(t->memory);
+            if (source_gpu) {
+                HostRange range = host_range(source_gpu, size);
+                source = reinterpret_cast<const uint8_t*>(range.address);
+            }
+            if (!source) fail(texture_context(guest, *t) + ": texture storage is not CPU mapped");
+            prepare_counter_read(source, size);
+            Format input = format_for(t->format);
+            std::vector<uint8_t> payload;
+            auto levels = convert_payload(*t, source, input, *backing, payload);
+            uint32_t bw = 1, bh = 1, bytes = 0;
+            if (backing->decoded || backing->expanded_rgb || t->format == 0x3f)
+                bytes = host_bytes(backing->host_format);
+            else
+                bw = input.block_width, bh = input.block_height, bytes = input.bytes;
+            upload_payload(*t, *backing, backing->object, payload, levels, bw, bh, bytes);
+            backing->initialized = true;
+        } else if (attachment) {
+            // Attachments start undefined and are made initialized by the first Metal render/clear through mark_rendered.
+        } else if (is_depth_stencil_format(t->format)) {
+            fail(texture_context(guest, *t) + ": depth/stencil image was sampled before a native render initialized it");
+        } else if (t->flags & 0x8) {
+            zero_texture(*t, *backing);
+        } else if (!t->has_writes.load(std::memory_order_acquire)) {
+            fail(texture_context(guest, *t) + ": neither CPU storage nor a prior Metal render is available");
+        }
+    }
+
+    if (t->dirty.exchange(false, std::memory_order_acq_rel)) {
+        uint64_t dirty_lo = t->dirty_lo.exchange(UINT64_MAX, std::memory_order_acq_rel);
+        uint64_t dirty_hi = t->dirty_hi.exchange(0, std::memory_order_acq_rel);
+        if (dirty_hi <= dirty_lo) dirty_lo = 0, dirty_hi = UINT64_MAX;
+        if ((!t->memory && !t->gpu) || !t->storage_size)
+            fail(texture_context(guest, *t) + ": dirty texture has no CPU backing");
+        Format input = format_for(t->format);
+        const uint8_t* source = reinterpret_cast<const uint8_t*>(t->memory);
+        if (t->gpu) {
+            HostRange range = host_range(t->gpu, t->storage_size);
+            source = reinterpret_cast<const uint8_t*>(range.address);
+        }
+        prepare_counter_read(source, t->storage_size);
+        if (backing->rendered) {
+            upload_pitch_dirty(*t, *backing, source, dirty_lo, dirty_hi);
+        } else {
+            std::vector<uint8_t> payload;
+            auto levels = convert_payload(*t, source, input, *backing, payload);
+            uint32_t bw = 1, bh = 1, bytes = 0;
+            if (backing->decoded || backing->expanded_rgb || t->format == 0x3f) bytes = host_bytes(backing->host_format);
+            else bw = input.block_width, bh = input.block_height, bytes = input.bytes;
+            end_encoding();
+            upload_payload(*t, *backing, backing->object, payload, levels, bw, bh, bytes);
+        }
+    }
+    if (t->has_writes.load(std::memory_order_acquire)) {
+        if (!backing->initialized && t->flags & 0x8 && !is_depth_stencil_format(t->format)) zero_texture(*t, *backing);
+        apply_writes(*t, *backing);
+    }
+    if (!attachment && !storage && !backing->initialized)
+        fail(texture_context(guest, *t) + ": sampled texture has no initialized Metal contents");
+
+    if (!attachment && !storage && shape && shape->dim == 3 && t->target != 8 && t->target != 9) {
+        static uint64_t incompatible_cube_samples = 0;
+        if (++incompatible_cube_samples % 1000 == 1)
+            log("nvn/metal: incompatible sampled cube from NVN target %u: initialized cube replacement (%llu uses)",
+                t->target, (unsigned long long)incompatible_cube_samples);
+        return incompatible_cube_sample(*shape);
+    }
+
+    uint32_t base_level = view ? view->base_level : 0;
+    uint32_t count_levels = view && view->levels ? view->levels : mip_count(*t) - base_level;
+    uint32_t base_slice = view ? view->min_layer : 0;
+    uint32_t slice_count = view && view->layers ? view->layers : texture_slices(*t) - base_slice;
+    const bool cube_face_attachment = attachment && (t->target == 8 || t->target == 9) && view && view->layers == 1;
+    MTLTextureType type = cube_face_attachment ? MTLTextureType2D : view_type(*t, shape);
+    if (cube_face_attachment) {
+        slice_count = 1;
+    } else if (shape && !shape->arrayed && (!view || !view->layers)) {
+        if (shape->dim == 3) slice_count = 6;
+        else if (shape->dim == 2 || shape->dim == 1 || shape->dim == 0) slice_count = 1;
+    }
+    // Metal cube texture views select faces in groups of six. Match the existing Vulkan view rules:
+    // a Cube view covers one cube, while a CubeArray view keeps only complete cubes.
+    if (type == MTLTextureTypeCube || type == MTLTextureTypeCubeArray) {
+        if (base_slice % 6)
+            fail(texture_context(guest, *t) + ": cube texture view must start on a six-face boundary");
+        if (type == MTLTextureTypeCube) slice_count = 6;
+        else slice_count -= slice_count % 6;
+    }
+    if (!count_levels || base_level + count_levels > mip_count(*t) || !slice_count ||
+        base_slice + slice_count > texture_slices(*t))
+        fail(texture_context(guest, *t) + ": invalid NVN texture view range: levels " +
+             std::to_string(base_level) + "+" + std::to_string(count_levels) + "/" + std::to_string(mip_count(*t)) +
+             " slices " + std::to_string(base_slice) + "+" + std::to_string(slice_count) + "/" +
+             std::to_string(texture_slices(*t)) + " target " + std::to_string(t->target) +
+             " Metal type " + std::to_string(uint32_t(type)));
+    uint32_t view_format_id = view ? view->format : 0;
+    uint32_t output_format_id = view_format_id ? view_format_id : t->format;
+    uint32_t output_host = host_format(output_format_id, backing->bc && backing->decoded,
+                                       backing->astc && backing->decoded);
+    if (backing->expanded_rgb) output_host = rgb_expansion_format(output_format_id);
+    if (t->format == 0x3f) output_host = 0x29;
+    MTLPixelFormat pixel = format_for(output_host).pixel;
+    if (pixel == MTLPixelFormatInvalid) fail(texture_context(guest, *t) + ": view has no Metal pixel format");
+    MTLTextureSwizzleChannels sw = view_swizzle(*t, view);
+    bool full_view = base_level == 0 && count_levels == mip_count(*t) && base_slice == 0 &&
+                     slice_count == texture_slices(*t) && pixel == backing->object.pixelFormat &&
+                     type == backing->object.textureType && sw.red == MTLTextureSwizzleRed &&
+                     sw.green == MTLTextureSwizzleGreen && sw.blue == MTLTextureSwizzleBlue &&
+                     sw.alpha == MTLTextureSwizzleAlpha;
+    if (full_view) return backing->object;
+    auto key = std::make_tuple(uint32_t(pixel), uint32_t(type), base_level, count_levels, base_slice, slice_count,
+                               uint32_t(sw.red) | (uint32_t(sw.green) << 8) | (uint32_t(sw.blue) << 16) |
+                                   (uint32_t(sw.alpha) << 24));
+    auto it = backing->views.find(key);
+    if (it != backing->views.end()) return it->second;
+    id<MTLTexture> result = nil;
+    if (@available(macOS 10.15, *)) {
+        result = [backing->object newTextureViewWithPixelFormat:pixel textureType:type
+                                                         levels:NSMakeRange(base_level, count_levels)
+                                                         slices:NSMakeRange(base_slice, slice_count) swizzle:sw];
+    } else {
+        if (sw.red != MTLTextureSwizzleRed || sw.green != MTLTextureSwizzleGreen ||
+            sw.blue != MTLTextureSwizzleBlue || sw.alpha != MTLTextureSwizzleAlpha)
+            fail(texture_context(guest, *t) + ": texture swizzles require macOS 10.15 or later");
+        result = [backing->object newTextureViewWithPixelFormat:pixel textureType:type
+                                                         levels:NSMakeRange(base_level, count_levels)
+                                                         slices:NSMakeRange(base_slice, slice_count)];
+    }
+    if (!result) fail(texture_context(guest, *t) + ": Metal rejected the requested format/subresource/swizzle view");
+    backing->views.emplace(key, result);
+    return result;
+}
+
+void forget_texture(const Texture*) {
+    // Texture owns the shared MetalBacking; descriptor snapshots share that backing. ARC releases the Metal textures
+    // when the last Texture/snapshot reference and all in-flight command buffers let go.
+}
+
+id<MTLSamplerState> sampler(const SamplerInfo& info, bool shadow) {
+    static std::map<std::string, __strong id<MTLSamplerState>> cache;
+    static std::mutex lock;
+    std::string key(reinterpret_cast<const char*>(&info), sizeof info);
+    key.push_back(shadow ? '\1' : '\0');
+    std::lock_guard guard(lock);
+    auto it = cache.find(key);
+    if (it != cache.end()) return it->second;
+    MTLSamplerDescriptor* d = [MTLSamplerDescriptor new];
+    uint32_t min = info.min_filter;
+    if (min > 5 || info.mag_filter > 1) fail("Metal sampler: unknown NVN min/mag filter");
+    d.minFilter = (min == 1 || min == 3 || min == 5) ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+    d.magFilter = info.mag_filter ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+    d.mipFilter = min <= 1 ? MTLSamplerMipFilterNotMipmapped
+                           : (min == 4 || min == 5) ? MTLSamplerMipFilterLinear : MTLSamplerMipFilterNearest;
+    d.sAddressMode = address_mode(info.wrap[0]);
+    d.tAddressMode = address_mode(info.wrap[1]);
+    d.rAddressMode = address_mode(info.wrap[2]);
+    d.lodMinClamp = min <= 1 ? 0.f : std::max(0.f, info.lod_min);
+    d.lodMaxClamp = min <= 1 ? 0.25f : std::max(d.lodMinClamp, info.lod_max);
+    d.maxAnisotropy = NSUInteger(std::clamp(info.max_anisotropy, 1.f, 16.f));
+    if (shadow) d.compareFunction = compare_function(info.compare_func);
+    bool border = info.wrap[0] == 5 || info.wrap[1] == 5 || info.wrap[2] == 5;
+    if (border) {
+        bool transparent = info.border[0] == 0.f && info.border[1] == 0.f && info.border[2] == 0.f && info.border[3] == 0.f;
+        bool black = info.border[0] == 0.f && info.border[1] == 0.f && info.border[2] == 0.f && info.border[3] == 1.f;
+        bool white = info.border[0] == 1.f && info.border[1] == 1.f && info.border[2] == 1.f && info.border[3] == 1.f;
+        if (!transparent && !black && !white) fail("Metal sampler: custom NVN border colors are unsupported");
+        d.borderColor = white ? MTLSamplerBorderColorOpaqueWhite
+                       : black ? MTLSamplerBorderColorOpaqueBlack
+                               : MTLSamplerBorderColorTransparentBlack;
+    }
+    if (info.reduction != 0 || info.lod_bias != 0.f) {
+        if (@available(macOS 26.0, *)) {
+            d.reductionMode = info.reduction == 0 ? MTLSamplerReductionModeWeightedAverage
+                              : info.reduction == 1 ? MTLSamplerReductionModeMinimum
+                              : info.reduction == 2 ? MTLSamplerReductionModeMaximum
+                                                    : (fail("Metal sampler: unknown NVN reduction mode"),
+                                                       MTLSamplerReductionModeWeightedAverage);
+            d.lodBias = info.lod_bias;
+        } else {
+            fail("Metal sampler: reduction modes and LOD bias require macOS 26 or later");
+        }
+    }
+    id<MTLSamplerState> result = [device() newSamplerStateWithDescriptor:d];
+    if (!result) fail("Metal sampler: device rejected NVN sampler state");
+    cache.emplace(std::move(key), result);
+    return result;
+}
+
+MTLVertexFormat vertex_format(uint32_t f) {
+    switch (f) {
+        case 0x01: return MTLVertexFormatUCharNormalized;
+        case 0x02: return MTLVertexFormatCharNormalized;
+        case 0x03: return MTLVertexFormatUChar;
+        case 0x04: return MTLVertexFormatChar;
+        case 0x05: return MTLVertexFormatHalf;
+        case 0x06: return MTLVertexFormatUShortNormalized;
+        case 0x07: return MTLVertexFormatShortNormalized;
+        case 0x08: return MTLVertexFormatUShort;
+        case 0x09: return MTLVertexFormatShort;
+        case 0x0a: return MTLVertexFormatFloat;
+        case 0x0b: return MTLVertexFormatUInt;
+        case 0x0c: return MTLVertexFormatInt;
+        case 0x0d: return MTLVertexFormatUChar2Normalized;
+        case 0x0e: return MTLVertexFormatChar2Normalized;
+        case 0x0f: return MTLVertexFormatUChar2;
+        case 0x10: return MTLVertexFormatChar2;
+        case 0x11: return MTLVertexFormatHalf2;
+        case 0x12: return MTLVertexFormatUShort2Normalized;
+        case 0x13: return MTLVertexFormatShort2Normalized;
+        case 0x14: return MTLVertexFormatUShort2;
+        case 0x15: return MTLVertexFormatShort2;
+        case 0x16: return MTLVertexFormatFloat2;
+        case 0x17: return MTLVertexFormatUInt2;
+        case 0x18: return MTLVertexFormatInt2;
+        case 0x19: return MTLVertexFormatUChar3Normalized;
+        case 0x1a: return MTLVertexFormatChar3Normalized;
+        case 0x1b: return MTLVertexFormatUChar3;
+        case 0x1c: return MTLVertexFormatChar3;
+        case 0x1d: return MTLVertexFormatHalf3;
+        case 0x1e: return MTLVertexFormatUShort3Normalized;
+        case 0x1f: return MTLVertexFormatShort3Normalized;
+        case 0x20: return MTLVertexFormatUShort3;
+        case 0x21: return MTLVertexFormatShort3;
+        case 0x22: return MTLVertexFormatFloat3;
+        case 0x23: return MTLVertexFormatUInt3;
+        case 0x24: return MTLVertexFormatInt3;
+        case 0x25: return MTLVertexFormatUChar4Normalized;
+        case 0x26: return MTLVertexFormatChar4Normalized;
+        case 0x27: return MTLVertexFormatUChar4;
+        case 0x28: return MTLVertexFormatChar4;
+        case 0x29: return MTLVertexFormatHalf4;
+        case 0x2a: return MTLVertexFormatUShort4Normalized;
+        case 0x2b: return MTLVertexFormatShort4Normalized;
+        case 0x2c: return MTLVertexFormatUShort4;
+        case 0x2d: return MTLVertexFormatShort4;
+        case 0x2e: return MTLVertexFormatFloat4;
+        case 0x2f: return MTLVertexFormatUInt4;
+        case 0x30: return MTLVertexFormatInt4;
+        case 0x3d: return MTLVertexFormatUInt1010102Normalized;
+        case 0x69: return MTLVertexFormatInt1010102Normalized;
+        case 0x51: case 0x52: case 0x53: case 0x54: case 0x55: case 0x56:
+        case 0x57: case 0x58: case 0x59: case 0x5a: case 0x5b: case 0x5c:
+        case 0x5d: case 0x5e: case 0x5f: case 0x60: case 0x61: case 0x62:
+        case 0x63: case 0x64: case 0x65: case 0x66: case 0x67: case 0x68:
+        case 0x6a: case 0x6b: case 0x6c:
+            fail("Metal vertex input: NVN scaled/packed format has no exact Metal vertex format");
+        case 0x3f:
+            if (@available(macOS 14.0, *)) return MTLVertexFormatFloatRG11B10;
+            fail("Metal vertex input: packed 11/11/10 float requires macOS 14 or later");
+        case 0x40:
+            if (@available(macOS 14.0, *)) return MTLVertexFormatFloatRGB9E5;
+            fail("Metal vertex input: packed RGB9E5 requires macOS 14 or later");
+        default: fail("Metal vertex input: unknown NVN vertex format " + std::to_string(f));
+    }
+}
