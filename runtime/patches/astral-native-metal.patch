+[[noreturn]] void fail(const std::string& message) { nx::fatal("native Metal: %s",message.c_str()); }
+void set_alias_recording(bool on) { g_alias_record=on; }
+static void merge_interval(std::map<uint64_t,uint64_t>& m, uint64_t begin, uint64_t end) {
+    auto i=m.upper_bound(begin);
+    if(i!=m.begin()){auto p=std::prev(i);if(p->second>=end)return;if(p->second>=begin)begin=p->first,i=p;}
+    while(i!=m.end()&&i->first<=end){end=std::max(end,i->second);i=m.erase(i);}
+    m.emplace(begin,end);
+}
+void note_gpu_write(uint64_t begin, uint64_t end) { if(end>begin)merge_interval(g_gpu_write_intervals,begin,end); }
+void note_alias_read(uint64_t begin, uint64_t end) {
+    if(!g_alias_record||end<=begin)return;
+    auto i=g_alias_reads.upper_bound(begin);
+    if(i!=g_alias_reads.begin()) {
+        auto p=std::prev(i);
+        if(p->second>=end)return;                    // already covered by a recorded interval
+        if(p->second>=begin)begin=p->first,i=p;      // extends the left neighbor
+    }
+    while(i!=g_alias_reads.end()&&i->first<=end) {   // absorb adjacent and overlapping intervals
+        end=std::max(end,i->second);
+        i=g_alias_reads.erase(i);
+    }
+    g_alias_reads.emplace(begin,end);
+}
+bool alias_reads_overlap(uint64_t begin, uint64_t end) {
+    if(end<=begin||g_alias_reads.empty())return false;
+    auto i=g_alias_reads.upper_bound(begin);
+    if(i!=g_alias_reads.begin()) {
+        auto p=std::prev(i);
+        if(p->second>begin)return true;
+    }
+    return i!=g_alias_reads.end()&&i->first<end;
+}
