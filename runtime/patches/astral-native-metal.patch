+bool submit_current(CommitReason reason) {
+    end_encoding();
+    if (!g_command) return false;
+    if (g_pending_submissions.size()>=kMaxPendingSubmissions)
+        fail("Metal pending submission capacity was not drained before commit");
+    id<MTLCommandBuffer> cmd = g_command; g_command = nil;
+    {static const char* const names[]={"cpu-read","buffer-update","counter","submit","present","explicit-wait"};
+     [cmd setLabel:[NSString stringWithUTF8String:names[size_t(reason)]]];}
+    const uint64_t serial = ++g_submitted;
+    const uint64_t commit_started=plat::monotonic_ns();
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    if(!done)fail("Metal command completion semaphore creation failed");
+    if(g_counter_samples&&g_sample_next>g_sample_cb_first){
+        const NSUInteger count=NSUInteger(g_sample_next-g_sample_cb_first);
+        auto* be=[cmd blitCommandEncoder];
+        [be resolveCounters:g_counter_samples inRange:NSMakeRange(NSUInteger(g_sample_cb_first),count)
+                    destinationBuffer:g_counter_resolve destinationOffset:NSUInteger(g_sample_cb_first*g_sample_bytes)];
+        [be endEncoding];
+    }
+    g_sample_cb_first=g_sample_next;
+    [cmd addCompletedHandler:^(id<MTLCommandBuffer>) { dispatch_semaphore_signal(done); }];
+    [cmd commit];
+    const uint64_t submitted_ns=plat::monotonic_ns();
