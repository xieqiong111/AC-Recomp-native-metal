+// A CPU read that may race pending GPU storage writes: drain only when the ranges overlap.
+void prepare_write_read(const void* bytes,uint64_t size) {
+    if(!bytes||!size||g_gpu_write_intervals.empty())return;
+    const uint64_t begin=reinterpret_cast<uintptr_t>(bytes),end=begin+size;
+    if(begin>end)return;
+    auto i=g_gpu_write_intervals.upper_bound(begin);
+    if(i!=g_gpu_write_intervals.begin()){auto p=std::prev(i);if(p->second>begin){++g_write_read_drains;commit_wait(CommitReason::CpuRead);return;}}
+    if(i!=g_gpu_write_intervals.end()&&i->first<end){++g_write_read_drains;commit_wait(CommitReason::CpuRead);return;}
+    ++g_write_read_skips;
+}
+void prepare_counter_read(const void* bytes,uint64_t size) {
+    if(!bytes||!size||g_pending_counters.empty())return;
+    const std::uintptr_t read_begin=reinterpret_cast<std::uintptr_t>(bytes);
+    const std::uintptr_t max_address=std::numeric_limits<std::uintptr_t>::max();
+    if(size>uint64_t(max_address-read_begin)) { commit_wait(CommitReason::Counter); return; }
+    const std::uintptr_t read_end=read_begin+static_cast<std::uintptr_t>(size);
+    for(const auto& counter:g_pending_counters) {
+        if(counter->published.load(std::memory_order_acquire))continue;
+        const std::uintptr_t counter_begin=reinterpret_cast<std::uintptr_t>(counter->host_address);
+        if(counter_begin>max_address-16 || (read_begin<counter_begin+16 && counter_begin<read_end)) {
+            commit_wait(CommitReason::Counter);
+            return;
+        }
+    }
+}
