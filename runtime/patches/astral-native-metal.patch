+    commit_wait(CommitReason::CpuRead);
+}
+bool writes_shared_buffers(const Stage& compiled,const ShaderInfo* shader,uint32_t nvn_stage) {
+    const uint64_t mask=written_storage_bindings(shader);
+    bool writes=false;
+    for(const auto& binding:compiled.bindings) {
+        const auto& d=binding.descriptor;
+        if(d.type!=DescriptorType::StorageBuffer || d.nvn.source==NvnSource::UniformAsStorage)continue;
+        if(d.binding<64 && !(mask&(1ull<<d.binding)))continue;
+        writes=true;
+        if(d.nvn.index>=0 && d.nvn.index<16) {
+            const auto& range=replay::g_state.storage[nvn_stage][d.nvn.index];
+            if(range.address&&range.size) {
+                const Buffer b=buffer_for_gpu(range.address,range.size,false);
+                if(b.object&&b.object.contents&&b.offset<=b.object.length&&range.size<=b.object.length-b.offset)
+                    note_gpu_write(reinterpret_cast<uintptr_t>(static_cast<uint8_t*>(b.object.contents))+b.offset,
+                                   reinterpret_cast<uintptr_t>(static_cast<uint8_t*>(b.object.contents))+b.offset+range.size);
+            }
+        }
+    }
+    return writes;
+}
+MTLCompareFunction compare(uint32_t value) {
