+#pragma once
+#import <Metal/Metal.h>
+#include "nvn.h"
+#include "nvn_shaders.h"
+#include "nvn_metal_state.h"
+namespace nx::nvn::metal {
+bool init();
+id<MTLDevice> device();
+id<MTLCommandBuffer> command_buffer();
+void end_encoding();
+// Snapshot buffers are reused only after their command buffer has completed; replay holds the renderer lock.
+void recycle_snapshot_buffers();
+struct SnapshotStats {
+    uint64_t allocations=0,reuses=0,copied_bytes=0,retained_bytes=0;
+    uint64_t support_reuses=0,driver_reuses=0,constant_reuses=0,saved_copy_bytes=0,constant_bytes=0;
+    uint64_t cleared_bytes=0,saved_clear_bytes=0;
+};
+SnapshotStats snapshot_stats();
+[[noreturn]] void fail(const std::string& message);
+struct Buffer { __strong id<MTLBuffer> object = nil; NSUInteger offset = 0; };
+Buffer buffer_for_gpu(uint64_t address, uint64_t length, bool writable = false);
+// Coalesced canonical host ranges referenced by zero-copy aliases since the last full drain.
+// Uniform snapshots copy at bind time, so alias-referenced ranges are the only CPU-write hazard
+// for UpdateUniformBuffer; it skips its drain when the update range does not overlap one.
+void set_alias_recording(bool on);
+void note_alias_read(uint64_t host_begin, uint64_t host_end);
+bool alias_reads_overlap(uint64_t host_begin, uint64_t host_end);
+// Pending GPU storage-write ranges: a CPU read drains only when it overlaps one.
+void note_gpu_write(uint64_t host_begin, uint64_t host_end);
+void prepare_write_read(const void* bytes, uint64_t size);
+// Immediate CPU snapshot reads under the renderer lock; the caller must first resolve pending GPU writes.
+// Validates the complete physical/virtual mapping on every call. Do not retain this pointer across replay jobs.
+const uint8_t* mapped_buffer_bytes(uint64_t address, uint64_t length);
+// CPU-read preflight only: caller holds renderer lock and has not created its draw/dispatch encoder.
+// Resolve overlapping counter publications before copying their guest bytes.
+void prepare_counter_read(const void* bytes, uint64_t length);
+// These logical RGB/RGBX formats use a physical RGBA texture; their alpha is always one.
+inline bool emulated_no_alpha(uint32_t format) {
+    return (format >= 0x19 && format <= 0x24) || format == 0x37 || format == 0x3f;
+}
+id<MTLTexture> texture(uint64_t guest, const ViewInfo* view = nullptr, const ImageShape* shape = nullptr,
+                       bool attachment = false, bool storage = false);
+enum TextureAspect : uint8_t { TextureColor = 1, TextureDepth = 2, TextureStencil = 4, TextureAllAspects = 7 };
+bool subresource_initialized(uint64_t guest, const ViewInfo* view, uint8_t aspects);
+void mark_rendered(uint64_t guest, const ViewInfo* view = nullptr, uint8_t aspects = TextureAllAspects);
+id<MTLSamplerState> sampler(const SamplerInfo& info, bool shadow);
+MTLVertexFormat vertex_format(uint32_t nvn_format);
+struct Binding { DescriptorBinding descriptor; uint32_t buffer = 0, texture = 0, sampler = 0; };
+struct Stage { __strong id<MTLFunction> function = nil; std::vector<Binding> bindings; uint32_t buffer_count = 0; };
+const Stage& stage(const ShaderInfo* info, const uint8_t* integer_inputs = nullptr, uint32_t unwritten = 0,
+                   uint32_t alpha_func = 8, float alpha_ref = 0.0f);
+// Resolve uploads before creating an encoder, then retain exactly those resources for this draw/dispatch.
+struct StageImages {
+    struct Image {
+        __strong id<MTLTexture> texture = nil;
+        __strong id<MTLSamplerState> sampler = nil;
+        uint64_t guest = 0;
+        ViewInfo view;
+    };
+    std::vector<Image> bindings;
+};
+StageImages prepare_stage_images(const Stage& compiled, const ShaderInfo* info, uint32_t nvn_stage,
+                                 const replay::State& state);
+void bind_stage(id<MTLRenderCommandEncoder> render, id<MTLComputeCommandEncoder> compute, const Stage& compiled,
+                const ShaderInfo* info, uint32_t nvn_stage, const replay::State& state, const StageImages& images,
+                float width, float height);
+}
